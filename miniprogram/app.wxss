/* app.wxss — 全局样式（靛蓝主题） */

page {
  background: #F7F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* 通用容器 */
.container {
  padding: 24rpx 28rpx;
  padding-bottom: 120rpx; /* 给 tabbar 留空间 */
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(79,70,229,0.05);
  margin-bottom: 20rpx;
}

/* 通用标签文字 */
.text-income { color: #10B981; }
.text-expense { color: #EF4444; }

/* 通用 section 标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 12rpx;
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}
.empty-state .emoji { font-size: 64rpx; margin-bottom: 16rpx; }
.empty-state .title { font-size: 30rpx; font-weight: 600; color: #374151; margin-bottom: 8rpx; }
.empty-state .desc { font-size: 24rpx; color: #9CA3AF; }

/* 弹窗通用 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex;
  align-items: center; justify-content: center; z-index: 999;
}
.modal-content {
  width: 82%; background: #FFF; border-radius: 28rpx; overflow: hidden;
}
.modal-header {
  text-align: center; font-size: 32rpx; font-weight: 700; color: #1F2937;
  padding: 36rpx 28rpx 12rpx;
}
.modal-body { padding: 16rpx 36rpx 28rpx; }
.form-input {
  border: 2rpx solid #E5E7EB; border-radius: 16rpx;
  padding: 20rpx; font-size: 28rpx; background: #F9FAFB;
}
.modal-footer { display: flex; border-top: 1rpx solid #F3F4F6; }
.modal-footer view { flex: 1; text-align: center; padding: 28rpx; font-size: 30rpx; }
.btn-cancel { color: #6B7280; }
.btn-primary { color: #4F46E5; font-weight: 700; }
.btn-danger { color: #EF4444; font-weight: 700; }
.modal-hint { font-size: 22rpx; color: #9CA3AF; margin-top: 12rpx; display: block; }
.modal-warn { font-size: 26rpx; color: #EF4444; line-height: 1.6; }
