/* app.wxss — 全局样式 */

/* 色彩体系 */
/* 主色 #1A73E8  辅色 #4285F4  收入 #4CAF50  支出 #FF5252 */
/* 背景 #F5F6FA  卡片 #FFFFFF  文字 #2D3436  次要 #90A4AE */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
  background-color: #F5F6FA;
  color: #2D3436;
  font-size: 28rpx;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 通用容器 */
.container {
  padding: 24rpx 28rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  min-height: 100vh;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(26, 115, 232, 0.05);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #1A73E8, #4285F4);
  color: #FFFFFF;
  border: none;
  border-radius: 44rpx;
  padding: 22rpx 64rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 1rpx;
}
.btn-primary::after { border: none; }

/* 次按钮 */
.btn-secondary {
  background: #F5F6FA;
  color: #1A73E8;
  border: 2rpx solid #E3F2FD;
  border-radius: 44rpx;
  padding: 18rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}
.btn-secondary::after { border: none; }

/* 收入/支出按钮 */
.btn-income {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #FFFFFF;
  border: none;
  border-radius: 44rpx;
  padding: 22rpx 64rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
.btn-income::after { border: none; }

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-income { background: #E8F5E9; color: #388E3C; }
.tag-expense { background: #FFEBEE; color: #C62828; }
.tag-budget { background: #FFF3E0; color: #E65100; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
  text-align: center;
}
.empty-state .emoji { font-size: 120rpx; margin-bottom: 28rpx; }
.empty-state .title { font-size: 32rpx; font-weight: 600; color: #2D3436; margin-bottom: 12rpx; }
.empty-state .desc  { font-size: 26rpx; color: #90A4AE; margin-bottom: 40rpx; line-height: 1.5; }

/* 分隔线 */
.divider { height: 1rpx; background: #F0F2F5; margin: 16rpx 0; }

/* 工具类 */
.mt-20 { margin-top: 20rpx; }
.mt-40 { margin-top: 40rpx; }
.mb-20 { margin-bottom: 20rpx; }
.text-income { color: #4CAF50; }
.text-expense { color: #FF5252; }

.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-1 { flex: 1; }

/* 页面过渡 */
page {
  animation: pageIn 0.25s ease-out;
}
@keyframes pageIn { from{opacity:0} to{opacity:1} }

/* 按钮反馈 */
view[class*="btn"]:active {
  transform: scale(0.96);
  transition: transform 0.1s;
}

/* 骨架屏动画 */
@keyframes shimmer {
  0% { background-position: 200% 0 }
  100% { background-position: -200% 0 }
}
