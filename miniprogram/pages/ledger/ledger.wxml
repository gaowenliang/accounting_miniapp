<!-- pages/ledger/ledger.wxml — 账本详情+统计 -->
<wxs src="../../utils/format.wxs" module="fmt"></wxs>
<view class="container" wx:if="{{ledger}}">

  <!-- 头部 -->
  <view class="info-card">
    <text class="info-icon">{{ledger.icon}}</text>
    <view class="info-main">
      <text class="info-name">{{ledger.name}}</text>
      <text class="info-meta">{{ledger.type === 'shared' ? '共享 · ' + ledger.memberCount + '人' : '个人'}}</text>
    </view>
    <text class="info-time">{{ledger.createdAtText}}</text>
  </view>

  <!-- 快速统计 -->
  <view class="stats-row">
    <view class="stat-chip">
      <text class="stat-chip-val text-expense">¥{{fmt.fen2yuanInt(stats.totalExpense)}}</text>
      <text class="stat-chip-lbl">总支出</text>
    </view>
    <view class="stat-chip">
      <text class="stat-chip-val text-income">¥{{fmt.fen2yuanInt(stats.totalIncome)}}</text>
      <text class="stat-chip-lbl">总收入</text>
    </view>
    <view class="stat-chip">
      <text class="stat-chip-val primary">{{stats.billCount}}</text>
      <text class="stat-chip-lbl">笔数</text>
    </view>
    <view class="stat-chip">
      <text class="stat-chip-val">{{stats.dayCount}}</text>
      <text class="stat-chip-lbl">天数</text>
    </view>
  </view>

  <!-- 统计区块 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📊 账本统计</text>
      <view class="header-tabs">
        <text class="htab {{statPeriod === 'month' ? 'active' : ''}}" bindtap="setStatPeriod" data-p="month">本月</text>
        <text class="htab {{statPeriod === 'year' ? 'active' : ''}}" bindtap="setStatPeriod" data-p="year">今年</text>
        <text class="htab {{statPeriod === 'all' ? 'active' : ''}}" bindtap="setStatPeriod" data-p="all">全部</text>
      </view>
    </view>

    <!-- 收支概览 -->
    <view class="card" wx:if="{{periodStats}}">
      <view class="ps-row">
        <text class="ps-label">支出</text>
        <view class="ps-bar-wrap"><view class="ps-bar expense" style="width:{{periodStats.expensePct}}%"></view></view>
        <text class="ps-amt text-expense">¥{{fmt.fen2yuan(periodStats.totalExpense)}}</text>
      </view>
      <view class="ps-row">
        <text class="ps-label">收入</text>
        <view class="ps-bar-wrap"><view class="ps-bar income" style="width:{{periodStats.incomePct}}%"></view></view>
        <text class="ps-amt text-income">¥{{fmt.fen2yuan(periodStats.totalIncome)}}</text>
      </view>
      <view class="ps-row">
        <text class="ps-label">结余</text>
        <text class="ps-amt {{periodStats.balance >= 0 ? 'text-income' : 'text-expense'}}">{{periodStats.balance >= 0 ? '+' : ''}}¥{{fmt.absFen2yuan(periodStats.balance)}}</text>
      </view>
    </view>

    <!-- 支出排行 -->
    <view class="card" wx:if="{{periodStats.catRank.length > 0}}">
      <text class="card-title">支出排行</text>
      <view class="rank-item" wx:for="{{periodStats.catRank}}" wx:key="name">
        <text class="rank-icon">{{item.icon}}</text>
        <text class="rank-name">{{item.name}}</text>
        <view class="rank-bar-wrap"><view class="rank-bar" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
        <text class="rank-pct">{{item.pct}}%</text>
        <text class="rank-amt">¥{{fmt.fen2yuanInt(item.amount)}}</text>
      </view>
    </view>

    <!-- 人员统计（多人时） -->
    <view class="card" wx:if="{{periodStats.personRank.length > 1}}">
      <text class="card-title">人员支出</text>
      <view class="rank-item" wx:for="{{periodStats.personRank}}" wx:key="name">
        <text class="rank-icon">{{item.avatar}}</text>
        <text class="rank-name">{{item.name}}</text>
        <view class="rank-bar-wrap"><view class="rank-bar" style="width:{{item.pct}}%;background:#4F46E5"></view></view>
        <text class="rank-pct">{{item.pct}}%</text>
        <text class="rank-amt">¥{{fmt.fen2yuanInt(item.amount)}}</text>
      </view>
    </view>

    <!-- 最近动态 -->
    <view class="card" wx:if="{{recentBills.length > 0}}">
      <text class="card-title">最近记录</text>
      <view class="rb-item" wx:for="{{recentBills}}" wx:key="id">
        <text class="rb-icon">{{item.icon}}</text>
        <view class="rb-info">
          <text class="rb-cat">{{item.catName}}</text>
          <text class="rb-note">{{item.note}}</text>
        </view>
        <text class="rb-amt {{item.type === 'income' ? 'text-income' : 'text-expense'}}">
          {{item.type === 'income' ? '+' : '-'}}¥{{fmt.fen2yuan(item.amountDisplay)}}
        </text>
      </view>
      <view class="rb-more" bindtap="goBills">查看全部明细 ›</view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="section">
    <view class="card">
      <view class="action-item" bindtap="showRenameModal">
        <text class="action-icon">✏️</text>
        <text class="action-label">重命名</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" wx:if="{{ledger.type === 'shared'}}" bindtap="goMembers">
        <text class="action-icon">👥</text>
        <text class="action-label">成员管理</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="goExport">
        <text class="action-icon">📤</text>
        <text class="action-label">导出数据</text>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="section">
    <view class="card">
      <view class="action-item" wx:if="{{ledger.type === 'shared' && ledger.role !== 'owner'}}" bindtap="leaveLedger">
        <text class="action-icon">🚪</text>
        <text class="action-label danger">退出账本</text>
      </view>
      <view class="action-item" wx:if="{{ledger.role === 'owner'}}" bindtap="deleteLedger">
        <text class="action-icon">🗑️</text>
        <text class="action-label danger">删除账本</text>
      </view>
    </view>
  </view>

  <!-- 重命名弹窗 -->
  <view class="modal-mask" wx:if="{{showRename}}" bindtap="cancelRename">
    <view class="modal-content" catchtap="">
      <view class="modal-header">重命名</view>
      <view class="modal-body">
        <input class="form-input" placeholder="账本名称" value="{{newName}}" bindinput="onNewNameInput" focus="{{showRename}}" />
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelRename">取消</view>
        <view class="btn-primary" bindtap="confirmRename">确认</view>
      </view>
    </view>
  </view>
</view>
