<!-- pages/stats/stats.wxml — 统计分析 -->
<wxs src="../../utils/format.wxs" module="fmt"></wxs>
<view class="container">

  <!-- 模式切换 -->
  <view class="mode-switch">
    <view class="mode-btn {{mode === 'monthly' ? 'active' : ''}}" bindtap="switchMode" data-mode="monthly">月度</view>
    <view class="mode-btn {{mode === 'yearly' ? 'active' : ''}}" bindtap="switchMode" data-mode="yearly">年度</view>
    <view class="mode-btn {{mode === 'person' ? 'active' : ''}}" bindtap="switchMode" data-mode="person">👤 按人</view>
    <view class="mode-btn {{mode === 'aa' ? 'active aa-active' : ''}}" bindtap="switchMode" data-mode="aa">AA结算</view>
  </view>

  <!-- ===== 月度 ===== -->
  <block wx:if="{{mode === 'monthly'}}">
    <view class="period-nav">
      <view class="nav-arrow" bindtap="prevMonth">◀</view>
      <text class="period-label">{{currentYear}}年{{currentMonth}}月</text>
      <view class="nav-arrow" bindtap="nextMonth">▶</view>
    </view>

    <view class="sub-tabs">
      <view class="sub-tab {{subMode === 'category' ? 'active' : ''}}" bindtap="switchSubMode" data-mode="category">分类</view>
      <view class="sub-tab {{subMode === 'currency' ? 'active' : ''}}" bindtap="switchSubMode" data-mode="currency">货币</view>
      <view class="sub-tab {{subMode === 'account' ? 'active' : ''}}" bindtap="switchSubMode" data-mode="account">账户</view>
    </view>

    <view class="card summary-card">
      <view class="summary-row">
        <text class="summary-label">收入</text>
        <view class="summary-bar-wrap">
          <view class="summary-bar income-bar" style="width:{{monthIncome/(monthIncome+monthExpense||1)*100}}%"></view>
        </view>
        <text class="summary-amount text-income">¥{{fmt.fen2yuan(monthIncome)}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">支出</text>
        <view class="summary-bar-wrap">
          <view class="summary-bar expense-bar" style="width:{{monthExpense/(monthIncome+monthExpense||1)*100}}%"></view>
        </view>
        <text class="summary-amount text-expense">¥{{fmt.fen2yuan(monthExpense)}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="balance-row">
        <text class="summary-label">结余</text>
        <text class="balance-amount {{monthBalance >= 0 ? 'text-income' : 'text-expense'}}">
          ¥{{fmt.absFen2yuan(monthBalance)}}
        </text>
      </view>
    </view>

    <!-- 分类维度 -->
    <block wx:if="{{subMode === 'category'}}">
    <!-- 图表切换 -->
    <view class="chart-toggle">
      <text class="chart-toggle-item {{chartType === 'donut' ? 'active' : ''}}" bindtap="switchChart" data-type="donut">占比图</text>
      <text class="chart-toggle-divider">|</text>
      <text class="chart-toggle-item {{chartType === 'list' ? 'active' : ''}}" bindtap="switchChart" data-type="list">列表</text>
    </view>

    <!-- 占比图模式 -->
    <view class="card" wx:if="{{chartType === 'donut'}}">
      <text class="section-title-inline">折合人民币金额</text>
      <!-- 横向占比条 -->
      <view class="donut-bar-wrap">
        <view class="donut-bar-segment" wx:for="{{categoryRanking}}" wx:key="name"
              style="width:{{item.percent}}%;background:{{item.color}}">
        </view>
      </view>
      <!-- 图例 -->
      <view class="donut-legend">
        <view class="legend-item" wx:for="{{categoryRanking}}" wx:key="name">
          <view class="legend-dot" style="background:{{item.color}}"></view>
          <text class="legend-text">{{item.icon}} {{item.name}} {{item.percent}}%</text>
        </view>
      </view>
    </view>

    <!-- 列表模式 -->
    <view class="card" wx:if="{{chartType === 'list'}}">
      <!-- 表头 -->
      <view class="cat-rank-header">
        <text>分类</text><text>笔数</text><text>金额(¥)</text><text>占比</text>
      </view>
      <!-- 数据行 -->
      <view class="cat-rank-row" wx:for="{{categoryRanking}}" wx:key="name">
        <view class="cat-rank-name">
          <view class="cat-rank-dot" style="background:{{item.color}}"></view>
          <text>{{item.icon}} {{item.name}}</text>
        </view>
        <text>{{item.count || 0}}笔</text>
        <text>¥{{item.amountStr || '0.00'}}</text>
        <text>{{item.percent}}%</text>
      </view>
      <!-- 合计行 -->
      <view class="cat-rank-total" wx:if="{{categoryRanking.length > 0}}">
        <text>合计</text>
        <text></text>
        <text>¥{{fmt.fen2yuan(categoryTotal)}}</text>
        <text>100%</text>
      </view>
      <view class="empty-hint" wx:if="{{categoryRanking.length === 0}}">暂无数据</view>
    </view>

    <view class="section-title" wx:if="{{dailyTrend.length > 0}}">每日趋势</view>
    <view class="card" wx:if="{{dailyTrend.length > 0}}">
      <view class="trend-chart">
        <view class="trend-bar-wrap" wx:for="{{dailyTrend}}" wx:key="day">
          <view class="trend-bar" style="height:{{item.height}}%"></view>
          <text class="trend-label">{{item.day}}</text>
        </view>
      </view>
    </view>
    </block>

    <!-- 货币统计 -->
    <block wx:if="{{subMode === 'currency'}}">
      <view class="card">
        <text class="section-title-inline">按币种统计</text>
        <view class="currency-stat-row currency-stat-header">
          <text class="cs-code">币种</text>
          <text class="cs-count">笔数</text>
          <text class="cs-amount">金额</text>
          <text class="cs-cny">折合人民币</text>
          <text class="cs-pct">占比</text>
        </view>
        <view class="currency-stat-row" wx:for="{{currencyStats.list}}" wx:key="code">
          <text class="cs-code">{{item.flag}} {{item.code}}</text>
          <text class="cs-count">{{item.count}}笔</text>
          <text class="cs-amount">{{item.symbol}}{{fmt.fen2yuan(item.amount)}}</text>
          <text class="cs-cny">¥{{fmt.fen2yuan(item.amountCNY)}}</text>
          <text class="cs-pct">{{item.percent}}%</text>
        </view>
        <view class="empty-hint" wx:if="{{currencyStats.list.length === 0}}">暂无数据</view>
      </view>

      <view class="card" wx:if="{{currencyStats.list.length > 1}}">
        <text class="section-title-inline">折合人民币占比</text>
        <view class="donut-chart-area">
          <view class="donut-bar" wx:for="{{currencyStats.list}}" wx:key="code"
                style="width:{{item.percent}}%;background:{{item.code==='CNY'?'#00C4B8':item.code==='USD'?'#8B5CF6':item.code==='EUR'?'#3B82F6':'#FFAD60'}}">
            <text class="donut-label" wx:if="{{item.percent >= 10}}">{{item.code}} {{item.percent}}%</text>
          </view>
        </view>
        <view class="donut-legend">
          <view class="legend-item" wx:for="{{currencyStats.list}}" wx:key="code">
            <view class="legend-dot" style="background:{{item.code==='CNY'?'#00C4B8':item.code==='USD'?'#8B5CF6':item.code==='EUR'?'#3B82F6':'#FFAD60'}}"></view>
            <text class="legend-text">{{item.name}} ({{item.code}})</text>
          </view>
        </view>
      </view>

      <!-- 汇率折算表 -->
      <view class="card" wx:if="{{currencyStats.list.length > 1}}">
        <text class="section-title-inline">按币种分汇率统计</text>
        <view class="rate-stat-header">
          <text class="rs-cur">币种</text>
          <text class="rs-rate">汇率</text>
          <text class="rs-amount">金额</text>
          <text class="rs-cny">折合人民币</text>
        </view>
        <view class="rate-stat-row" wx:for="{{currencyStats.list}}" wx:key="code">
          <text class="rs-cur">{{item.flag}} {{item.code}}</text>
          <text class="rs-rate">{{item.rateDisplay || '-'}}</text>
          <text class="rs-amount">{{item.symbol}}{{fmt.fen2yuan(item.amount)}}</text>
          <text class="rs-cny">¥{{fmt.fen2yuan(item.amountCNY)}}</text>
        </view>
      </view>
    </block>

    <!-- 账户统计 -->
    <block wx:if="{{subMode === 'account'}}">
      <view class="card">
        <text class="section-title-inline">成员×账户统计</text>
        <view class="account-stat-header">
          <text>成员-账户</text><text>笔数</text><text>金额(¥)</text><text>占比</text>
        </view>
        <view class="account-stat-row" wx:for="{{accountStats.list}}" wx:key="payerId">
          <text class="as-name">{{item.payerName}}-{{item.accountName}}</text>
          <text class="as-count">{{item.count}}笔</text>
          <text class="as-amount">¥{{fmt.fen2yuan(item.amountCNY)}}</text>
          <text class="as-pct">{{item.percent}}%</text>
        </view>
        <view class="empty-hint" wx:if="{{accountStats.list.length === 0}}">暂无数据</view>
      </view>
      <view class="card" wx:if="{{accountStats.list.length > 0}}">
        <text class="section-title-inline">折合人民币对比</text>
        <view class="h-bar-item" wx:for="{{accountStats.list}}" wx:key="payerId">
          <text class="h-bar-label">{{item.payerName}}-{{item.accountName}}</text>
          <view class="h-bar-wrap"><view class="h-bar" style="width:{{item.percent}}%"></view></view>
          <text class="h-bar-val">¥{{fmt.fen2yuanInt(item.amountCNY)}}</text>
        </view>
      </view>
    </block>

  </block>

  <!-- ===== 年度 ===== -->
  <block wx:if="{{mode === 'yearly'}}">
    <view class="period-nav">
      <view class="nav-arrow" bindtap="prevYear">◀</view>
      <text class="period-label">{{currentYear}}年</text>
      <view class="nav-arrow" bindtap="nextYear">▶</view>
    </view>

    <view class="card summary-card">
      <view class="summary-row">
        <text class="summary-label">收入</text>
        <text class="summary-amount text-income">¥{{fmt.fen2yuan(yearlyIncome)}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">支出</text>
        <text class="summary-amount text-expense">¥{{fmt.fen2yuan(yearlyExpense)}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="balance-row">
        <text class="summary-label">结余</text>
        <text class="balance-amount {{yearlyIncome-yearlyExpense >= 0 ? 'text-income' : 'text-expense'}}">
          ¥{{fmt.absFen2yuan(yearlyIncome-yearlyExpense)}}
        </text>
      </view>
    </view>

    <view class="section-title">月度趋势</view>
    <view class="card">
      <view class="yearly-legend">
        <view class="yearly-legend-item"><view class="yearly-legend-dot" style="background:#F87171"></view><text>支出</text></view>
        <view class="yearly-legend-item"><view class="yearly-legend-dot" style="background:#34D399"></view><text>收入</text></view>
      </view>
      <view class="yearly-row" wx:for="{{monthlyData}}" wx:key="month">
        <text class="yearly-month">{{item.month}}月</text>
        <view class="yearly-bar-wrap">
          <view class="yearly-bar expense" style="width:{{item.expense/(yearlyExpense||1)*100}}%"></view>
          <view class="yearly-bar income" style="width:{{item.income/(yearlyIncome||1)*100}}%"></view>
        </view>
        <text class="yearly-amount text-expense">¥{{fmt.fen2yuanInt(item.expense)}}</text>
        <text class="yearly-amount text-income">¥{{fmt.fen2yuanInt(item.income)}}</text>
      </view>
    </view>
  </block>

  <!-- ===== 按人统计 ===== -->
  <block wx:if="{{mode === 'person'}}">
    <view class="period-nav">
      <view class="nav-arrow" bindtap="prevMonth">◀</view>
      <text class="period-label">{{currentYear}}年{{currentMonth}}月</text>
      <view class="nav-arrow" bindtap="nextMonth">▶</view>
    </view>

    <view class="person-card" wx:for="{{personStats}}" wx:key="id" bindtap="togglePersonDetail" data-id="{{item.id}}">
      <view class="person-header">
        <text class="person-avatar">{{item.avatar}}</text>
        <text class="person-name">{{item.name}}</text>
        <text class="person-count">{{item.billCount}}笔</text>
        <text class="person-expand">{{expandedPerson === item.id ? '▲' : '▼'}}</text>
      </view>
      <view class="person-stats-row">
        <view class="person-stat">
          <text class="person-stat-label">支出</text>
          <text class="person-stat-value text-expense">¥{{fmt.fen2yuan(item.totalExpense)}}</text>
        </view>
        <view class="person-stat">
          <text class="person-stat-label">收入</text>
          <text class="person-stat-value text-income">¥{{fmt.fen2yuan(item.totalIncome)}}</text>
        </view>
      </view>
      <!-- 分类明细 -->
      <view class="person-cats" wx:if="{{item.categories}}">
        <view class="person-cat-item" wx:for="{{item.catList}}" wx:for-item="cat" wx:key="name">
          <text class="person-cat-name">{{cat.name}}</text>
          <view class="person-cat-bar-wrap">
            <view class="person-cat-bar" style="width:{{cat.percent}}%"></view>
          </view>
          <text class="person-cat-amount">¥{{fmt.fen2yuanInt(cat.amount)}}</text>
        </view>
      </view>
      <!-- 展开的账单明细 -->
      <view class="person-detail" wx:if="{{expandedPerson === item.id}}">
        <view class="pd-bill" wx:for="{{item.bills}}" wx:for-item="bill" wx:key="id">
          <text class="pd-bill-icon">{{bill.icon}}</text>
          <view class="pd-bill-info">
            <text class="pd-bill-cat">{{bill.catName}}</text>
            <text class="pd-bill-note">{{bill.note || ''}}</text>
          </view>
          <text class="pd-bill-amount {{bill.type === 'income' ? 'text-income' : 'text-expense'}}">
            {{bill.type === 'income' ? '+' : '-'}}¥{{fmt.fen2yuan(bill.amountDisplay)}}
          </text>
          <text class="pd-bill-date">{{bill.dateStr}}</text>
        </view>
      </view>
    </view>

    <view class="empty-hint" wx:if="{{personStats.length === 0}}">暂无数据，先记几笔吧</view>
  </block>

  <!-- ===== AA结算 ===== -->
  <block wx:if="{{mode === 'aa'}}">
    <view class="period-nav">
      <view class="nav-arrow" bindtap="prevMonth">◀</view>
      <text class="period-label">{{currentYear}}年{{currentMonth}}月</text>
      <view class="nav-arrow" bindtap="nextMonth">▶</view>
    </view>

    <!-- 参与人选择 -->
    <view class="card">
      <view class="aa-select-header">
        <text class="section-title-inline">选择参与AA的人</text>
        <view class="aa-toggle-all" bindtap="toggleAAAll">
          <text class="aa-toggle-text">{{aaAllSelected ? '取消全选' : '全选'}}</text>
        </view>
      </view>
      <view class="aa-participants">
        <view class="aa-person {{item.selected ? 'selected' : ''}}"
              wx:for="{{aaParticipants}}" wx:key="id"
              bindtap="toggleAAParticipant" data-id="{{item.id}}">
          <text class="aa-person-avatar">{{item.avatar}}</text>
          <text class="aa-person-name">{{item.name}}</text>
          <text class="aa-person-check" wx:if="{{item.selected}}">✓</text>
        </view>
      </view>
    </view>

    <!-- AA总览 -->
    <view class="card aa-summary" wx:if="{{aaResult}}">
      <view class="aa-summary-row">
        <text class="aa-summary-label">总支出</text>
        <text class="aa-summary-value">¥{{fmt.fen2yuan(aaResult.totalExpense)}}</text>
      </view>
      <view class="aa-summary-row">
        <text class="aa-summary-label">人均应出</text>
        <text class="aa-summary-value">¥{{fmt.fen2yuan(aaResult.perPerson)}}</text>
      </view>
      <view class="aa-summary-row">
        <text class="aa-summary-label">参与人数</text>
        <text class="aa-summary-value">{{aaResult.personCount || 0}}人</text>
      </view>
    </view>

    <!-- 每人已付/差额 -->
    <view class="card" wx:if="{{aaResult && aaParticipants.length > 0}}">
      <view class="section-title-inline">每人详情</view>
      <view class="aa-detail-item" wx:for="{{aaParticipants}}" wx:key="id" wx:if="{{item.selected}}">
        <view class="aa-detail-left">
          <text class="aa-detail-avatar">{{item.avatar}}</text>
          <text class="aa-detail-name">{{item.name}}</text>
        </view>
        <view class="aa-detail-right">
          <text class="aa-detail-paid">已付 ¥{{fmt.fen2yuan(item.paid)}}</text>
          <text class="aa-detail-balance {{item.balance > 0 ? 'text-income' : item.balance < 0 ? 'text-expense' : ''}}">
            {{item.balance > 0 ? '应收' : item.balance < 0 ? '应付' : '平'}} ¥{{fmt.absFen2yuan(item.balance)}}
          </text>
        </view>
      </view>
    </view>

    <!-- 结算明细 -->
    <view class="card" wx:if="{{aaResult && aaResult.details && aaResult.details.length > 0}}">
      <view class="section-title-inline">💰 结算方案</view>
      <view class="aa-settle-item" wx:for="{{aaResult.details}}" wx:key="index">
        <view class="aa-settle-flow">
          <view class="aa-settle-person">
            <text class="aa-settle-avatar">{{item.fromAvatar || '😊'}}</text>
            <text class="aa-settle-name">{{item.fromName}}</text>
          </view>
          <view class="aa-settle-arrow">
            <text class="aa-settle-amount">¥{{fmt.fen2yuan(item.amount)}}</text>
            <view class="aa-settle-dir">
              <text class="aa-arrow-anim">→</text>
              <text class="aa-settle-label">付给</text>
              <text class="aa-arrow-anim">→</text>
            </view>
          </view>
          <view class="aa-settle-person">
            <text class="aa-settle-avatar">{{item.toAvatar || '😊'}}</text>
            <text class="aa-settle-name">{{item.toName}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-hint" wx:if="{{aaResult && (!aaResult.details || aaResult.details.length === 0)}}">
      刚好平了，不用结算 🎉
    </view>
  </block>

  <!-- 分享按钮 -->
  <button class="share-btn-bottom" open-type="share">📤 分享统计</button>

</view>
