<!-- pages/add-bill/add-bill.wxml — 记账页 -->
<view class="container">

  <!-- 收入/支出切换 -->
  <view class="type-switch">
    <view class="type-btn {{billType === 'expense' ? 'active expense' : ''}}" bindtap="switchType" data-type="expense">
      支出
    </view>
    <view class="type-btn {{billType === 'income' ? 'active income' : ''}}" bindtap="switchType" data-type="income">
      收入
    </view>
  </view>

  <!-- 金额输入 -->
  <view class="amount-section">
    <text class="amount-prefix">¥</text>
    <input class="amount-input"
           type="digit"
           placeholder="0.00"
           placeholder-style="color:#C0C4CC"
           value="{{amountStr}}"
           bindinput="onAmountInput"
           bindconfirm="onAmountConfirm"
           focus="{{true}}" />
  </view>

  <!-- 分类网格 -->
  <view class="section">
    <text class="section-label">选择分类</text>
    <view class="category-grid">
      <view class="category-item {{selectedCategory === item.key ? 'selected' : ''}}"
            wx:for="{{categoryList}}" wx:key="key"
            bindtap="selectCategory" data-key="{{item.key}}">
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card note-card">
    <input class="note-input"
           placeholder="添加备注..."
           value="{{note}}"
           bindinput="onNoteInput"
           maxlength="200" />
  </view>

  <!-- 选项行 -->
  <view class="card options-card">
    <view class="option-item" bindtap="showDateAction">
      <text class="option-icon">📅</text>
      <text class="option-label">{{dateText}}</text>
      <text class="option-arrow">›</text>
    </view>
    <view class="option-item" bindtap="showAccountAction">
      <text class="option-icon">💳</text>
      <text class="option-label">{{selectedAccountName}}</text>
      <text class="option-arrow">›</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <view class="btn-submit {{billType === 'income' ? 'income' : ''}} {{submitting ? 'disabled' : ''}}"
          bindtap="{{submitting ? '' : 'submitBill'}}">
      {{submitting ? '保存中...' : '确认记账'}}
    </view>
  </view>

  <!-- 日期选择弹窗 -->
  <view class="modal-mask" wx:if="{{showDatePicker}}" bindtap="cancelDate">
    <view class="modal-content" catchtap="">
      <view class="modal-header">选择日期</view>
      <picker mode="date" value="{{dateText === '今天' ? '' : dateText}}" bindchange="onDateChange">
        <view class="picker-btn">选择日期</view>
      </picker>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelDate">取消</view>
      </view>
    </view>
  </view>

  <!-- 账户选择弹窗 -->
  <view class="modal-mask" wx:if="{{showAccountPicker}}" bindtap="cancelAccount">
    <view class="modal-content" catchtap="">
      <view class="modal-header">选择账户</view>
      <view class="account-list">
        <view class="account-option {{selectedAccount === (item.key || item.id) ? 'selected' : ''}}"
              wx:for="{{accounts}}" wx:key="id"
              bindtap="selectAccount" data-key="{{item.key || item.id}}">
          <text class="account-icon">{{item.icon}}</text>
          <text class="account-name">{{item.name}}</text>
          <text class="account-check" wx:if="{{selectedAccount === (item.key || item.id)}}">✓</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelAccount">取消</view>
      </view>
    </view>
  </view>

</view>
