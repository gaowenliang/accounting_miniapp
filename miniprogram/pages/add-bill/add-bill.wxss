/* pages/add-bill/add-bill.wxss — 记账页样式 */

/* 收入/支出切换 */
.type-switch {
  display: flex; margin-bottom: 32rpx;
  background: #F0F2F5; border-radius: 44rpx; padding: 4rpx;
}
.type-btn {
  flex: 1; text-align: center; padding: 16rpx 0;
  border-radius: 44rpx; font-size: 28rpx; font-weight: 600;
  color: #90A4AE; transition: all 0.2s;
}
.type-btn.active { color: #FFFFFF; }
.type-btn.active.expense { background: linear-gradient(135deg, #FF5252, #FF1744); }
.type-btn.active.income { background: linear-gradient(135deg, #4CAF50, #66BB6A); }

/* 金额区域 */
.amount-section {
  display: flex; align-items: baseline; justify-content: center;
  padding: 40rpx 0 48rpx;
}
.amount-prefix {
  font-size: 48rpx; font-weight: 700; color: #2D3436; margin-right: 8rpx;
}
.amount-input {
  font-size: 72rpx; font-weight: 700; color: #2D3436;
  min-width: 200rpx; text-align: center;
}

/* 分类 */
.section { margin-bottom: 24rpx; }
.section-label { font-size: 28rpx; font-weight: 600; color: #2D3436; margin-bottom: 16rpx; display: block; }
.category-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx;
}
.category-item {
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx; border-radius: 20rpx;
  background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.15s;
}
.category-item:active { transform: scale(0.95); }
.category-item.selected {
  background: #E3F2FD; border: 2rpx solid #1A73E8;
}
.category-icon { font-size: 40rpx; margin-bottom: 6rpx; }
.category-name { font-size: 22rpx; color: #607D8B; }
.category-item.selected .category-name { color: #1A73E8; font-weight: 600; }

/* 备注 */
.note-card { padding: 20rpx 24rpx; }
.note-input { font-size: 28rpx; color: #2D3436; }

/* 选项 */
.options-card { padding: 0; }
.option-item {
  display: flex; align-items: center; padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F2F5;
}
.option-item:last-child { border-bottom: none; }
.option-icon { font-size: 32rpx; margin-right: 12rpx; }
.option-label { flex: 1; font-size: 28rpx; color: #2D3436; }
.option-arrow { font-size: 32rpx; color: #C0C4CC; }

/* 提交 */
.submit-area { margin-top: 48rpx; padding: 0 20rpx; }
.btn-submit {
  background: linear-gradient(135deg, #FF5252, #FF1744);
  color: #FFFFFF; text-align: center; padding: 28rpx 0;
  border-radius: 44rpx; font-size: 32rpx; font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(255, 23, 68, 0.3);
}
.btn-submit.income {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.3);
}
.btn-submit.disabled { opacity: 0.6; }

/* 弹窗 */
.modal-mask {
  position: fixed; top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,0.45); display:flex;
  align-items:center; justify-content:center; z-index:999;
}
.modal-content {
  width: 80%; background: #FFFFFF; border-radius: 28rpx;
  overflow: hidden; padding: 32rpx;
}
.modal-header {
  text-align: center; font-size: 32rpx; font-weight: 600;
  color: #2D3436; margin-bottom: 24rpx;
}
.modal-footer {
  display: flex; justify-content: center; margin-top: 20rpx;
}
.btn-cancel {
  color: #90A4AE; font-size: 28rpx; padding: 12rpx 40rpx;
}
.picker-btn {
  text-align: center; padding: 20rpx; background: #F5F6FA;
  border-radius: 16rpx; color: #1A73E8; font-size: 28rpx;
}

/* 账户选择 */
.account-list { max-height: 400rpx; }
.account-option {
  display: flex; align-items: center; padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F0F2F5;
}
.account-option:last-child { border-bottom: none; }
.account-icon { font-size: 32rpx; margin-right: 12rpx; }
.account-name { flex: 1; font-size: 28rpx; }
.account-check { color: #1A73E8; font-size: 28rpx; font-weight: 700; }
.account-option.selected { background: #E3F2FD; border-radius: 12rpx; }
