<!-- pages/bills/bills.wxml — 账单明细 -->
<wxs src="../../utils/format.wxs" module="fmt"></wxs>
<view class="container">

  <!-- 月份导航 -->
  <view class="month-nav">
    <view class="nav-btn" bindtap="prevMonth">◀</view>
    <view class="nav-info">
      <text class="nav-month">{{monthLabel}}</text>
      <view class="nav-summary">
        <text class="text-income">收入 ¥{{fmt.fen2yuan(monthIncome)}}</text>
        <text class="nav-divider">|</text>
        <text class="text-expense">支出 ¥{{fmt.fen2yuan(monthExpense)}}</text>
      </view>
    </view>
    <view class="nav-btn" bindtap="nextMonth">▶</view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <view class="filter-tab {{filterType === 'all' ? 'active' : ''}}" bindtap="switchFilter" data-type="all">全部</view>
      <view class="filter-tab {{filterType === 'expense' ? 'active expense' : ''}}" bindtap="switchFilter" data-type="expense">支出</view>
      <view class="filter-tab {{filterType === 'income' ? 'active income' : ''}}" bindtap="switchFilter" data-type="income">收入</view>
    </view>
    <view class="filter-bar-right">
      <view class="search-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索..." value="{{searchKeyword}}" bindinput="onSearchInput" />
        <text class="search-clear" wx:if="{{searching}}" bindtap="clearSearch">✕</text>
      </view>
      <view class="detail-toggle" bindtap="toggleShowDetail">
        <text class="detail-toggle-text">{{showDetail ? '隐藏详情' : '显示详情'}}</text>
        <text class="detail-toggle-icon">{{showDetail ? '▼' : '▶'}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{groupedBills.length === 0 && !loading}}">
    <text class="emoji">📋</text>
    <text class="title">{{searching ? '没有找到相关账单' : '这个月还没有记录'}}</text>
    <text class="desc">{{searching ? '换个关键词试试' : '开始记一笔吧'}}</text>
  </view>

  <!-- 账单分组列表 -->
  <view class="bill-group" wx:for="{{groupedBills}}" wx:key="date">
    <view class="group-header">
      <text class="group-date">{{item.dateLabel}}</text>
      <view class="group-summary">
        <text class="text-income" wx:if="{{item.dayIncome > 0}}">+{{fmt.fen2yuan(item.dayIncome)}}</text>
        <text class="text-expense" wx:if="{{item.dayExpense > 0}}">-{{fmt.fen2yuan(item.dayExpense)}}</text>
      </view>
    </view>
    <view class="card">
      <view class="bill-item" wx:for="{{item.bills}}" wx:for-item="bill" wx:key="id">
        <view class="bill-left">
          <text class="bill-icon">{{bill.categoryIcon}}</text>
          <view class="bill-info">
            <text class="bill-category">{{bill.categoryName}}</text>
            <text class="bill-note" wx:if="{{bill.note}}">{{bill.note}}</text>
            <text class="bill-payer" wx:if="{{bill.payerName && bill.payerName !== '我'}}">{{bill.payerName}} 付款</text>
            <text class="bill-currency" wx:if="{{bill.currency && bill.currency !== 'CNY'}}">{{bill.currency}} → ≈¥{{bill.amountCNYText}}</text>
          </view>
        </view>
        <view class="bill-right">
          <text class="bill-amount {{bill.type === 'income' ? 'text-income' : 'text-expense'}}">
            {{bill.type === 'income' ? '+' : '-'}}{{bill.amountText}}
          </text>
          <view class="bill-actions">
            <text class="bill-action" catchtap="editBill" data-id="{{bill.id}}">编辑</text>
            <text class="bill-action action-delete" catchtap="deleteBill" data-id="{{bill.id}}">删除</text>
          </view>
        </view>
        <view class="bill-detail" wx:if="{{showDetail}}">
          <text class="bill-detail-item" wx:if="{{bill.payerName}}">👤 {{bill.payerName}} 付款</text>
          <text class="bill-detail-item" wx:if="{{bill.splitNames}}">👥 {{bill.splitNames}}</text>
          <text class="bill-detail-item" wx:if="{{bill.perPerson}}">📊 人均 {{bill.perPerson}}</text>
          <text class="bill-detail-item" wx:if="{{bill.currencyDisplay}}">💱 {{bill.currencyDisplay}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="cancelEdit">
    <view class="modal-content edit-modal" catchtap="">
      <view class="modal-header">编辑账单</view>
      <view class="modal-body">
        <view class="edit-row">
          <text class="edit-label">金额</text>
          <input class="edit-input" type="digit" value="{{editAmount}}" bindinput="onEditAmount" placeholder="0.00" />
        </view>
        <view class="edit-row">
          <text class="edit-label">分类</text>
          <view class="edit-cats">
            <view class="edit-cat {{editCategory === item.key ? 'selected' : ''}}"
                  wx:for="{{editCategories}}" wx:key="key"
                  bindtap="selectEditCategory" data-key="{{item.key}}">
              <text>{{item.icon}}</text>
              <text class="edit-cat-name">{{item.name}}</text>
            </view>
          </view>
        </view>
        <view class="edit-row">
          <text class="edit-label">备注</text>
          <input class="edit-input" value="{{editNote}}" bindinput="onEditNote" placeholder="备注" maxlength="200" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelEdit">取消</view>
        <view class="btn-primary" bindtap="confirmEdit">保存</view>
      </view>
    </view>
  </view>

</view>
