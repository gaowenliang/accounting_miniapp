/* pages/bills/bills.wxss — 靛蓝主题 */

/* 月份导航 */
.month-nav {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 0 20rpx;
}
.nav-btn { font-size: 28rpx; color: #4F46E5; font-weight: 600; padding: 8rpx 16rpx; }
.nav-info { text-align: center; }
.nav-month { font-size: 34rpx; font-weight: 700; color: #1F2937; }
.nav-summary { margin-top: 4rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 22rpx; }
.nav-divider { color: #D1D5DB; }

/* 筛选栏 */
.filter-bar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.filter-tabs {
  display: flex; background: #F3F4F6; border-radius: 44rpx; padding: 3rpx; flex-shrink: 0;
}
.filter-tab {
  padding: 8rpx 20rpx; border-radius: 44rpx;
  font-size: 24rpx; color: #9CA3AF; font-weight: 500;
}
.filter-tab.active { background: #4F46E5; color: #FFF; }
.filter-bar-right {
  flex: 1; display: flex; align-items: center; gap: 8rpx;
}
.search-wrap {
  flex: 1; display: flex; align-items: center;
  background: #FFFFFF; border-radius: 44rpx; padding: 8rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(79,70,229,0.04);
}
.search-icon { font-size: 22rpx; margin-right: 8rpx; }
.search-input { font-size: 24rpx; flex: 1; border: none; outline: none; }
.search-clear { font-size: 22rpx; color: #9CA3AF; padding: 4rpx; }

/* 详情开关 */
.detail-toggle {
  display: flex; align-items: center; gap: 4rpx;
  padding: 6rpx 16rpx; background: #F3F4F6; border-radius: 20rpx;
  flex-shrink: 0;
}
.detail-toggle-text { font-size: 22rpx; color: #6B7280; }
.detail-toggle-icon { font-size: 18rpx; color: #9CA3AF; }

/* 展开详情 */
.bill-detail {
  display: flex; flex-wrap: wrap; gap: 8rpx 16rpx;
  margin-top: 6rpx; padding-top: 6rpx;
  border-top: 1rpx solid #F9FAFB;
}
.bill-detail-item {
  font-size: 20rpx; color: #9CA3AF;
  background: #F9FAFB; padding: 2rpx 8rpx; border-radius: 6rpx;
}

/* 账单分组 */
.bill-group { margin-bottom: 16rpx; }
.group-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8rpx 8rpx 10rpx;
}
.group-date { font-size: 26rpx; font-weight: 600; color: #6B7280; }
.group-summary { display: flex; gap: 12rpx; font-size: 22rpx; }

/* 账单卡片 */
.card {
  background: #FFFFFF; border-radius: 20rpx; padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(79,70,229,0.05);
}
.bill-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid #F3F4F6;
  flex-wrap: wrap;
}
.bill-item:last-child { border-bottom: none; }
.bill-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.bill-icon { font-size: 40rpx; margin-right: 16rpx; flex-shrink: 0; }
.bill-info { display: flex; flex-direction: column; min-width: 0; }
.bill-category { font-size: 28rpx; font-weight: 500; color: #1F2937; }

/* 标题行 */
.bill-title-row { display: flex; align-items: center; gap: 8rpx; }

/* 分摊标签 */
.bill-split-tag { font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 8rpx; font-weight: 600; }
.bill-split-solo { background: #F3F4F6; color: #9CA3AF; }
.bill-split-aa { background: #DCFCE7; color: #16A34A; }
.bill-split-share { background: #FEF3C7; color: #D97706; }

/* 元信息行 */
.bill-meta { display: flex; flex-wrap: wrap; gap: 6rpx 14rpx; margin-top: 4rpx; }
.bill-payer { font-size: 20rpx; color: #6B7280; }
.bill-split-detail { font-size: 20rpx; color: #4F46E5; opacity: 0.8; }
.bill-note {
  font-size: 22rpx; color: #9CA3AF; margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.bill-payer { font-size: 20rpx; color: #6B7280; margin-top: 2rpx; }
.bill-currency { font-size: 18rpx; color: #F59E0B; margin-top: 2rpx; }
.bill-right { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; }
.bill-amount { font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.bill-detail { width: 100%; box-sizing: border-box; }

/* 操作按钮 */
.bill-actions { display: flex; gap: 16rpx; margin-top: 6rpx; }
.bill-action { font-size: 22rpx; color: #4F46E5; padding: 8rpx 12rpx; border-radius: 8rpx; background: #F9FAFB; }
.bill-action.action-delete { color: #EF4444; background: #FEF2F2; }

/* 编辑弹窗 */
.edit-row { margin-bottom: 16rpx; }
.edit-label { font-size: 24rpx; color: #9CA3AF; font-weight: 600; margin-bottom: 6rpx; display: block; }
.edit-input { border: 2rpx solid #E5E7EB; border-radius: 16rpx; padding: 16rpx; font-size: 28rpx; background: #F9FAFB; }
.edit-cats { display: flex; flex-wrap: wrap; gap: 8rpx; }
.edit-cat { display: flex; align-items: center; gap: 4rpx; padding: 6rpx 14rpx; border-radius: 16rpx; background: #F9FAFB; font-size: 22rpx; color: #6B7280; }
.edit-cat.selected { background: #EEF2FF; border: 2rpx solid #4F46E5; color: #4F46E5; font-weight: 600; }
.edit-cat-name { font-size: 20rpx; }
.bill-receipt-btn { font-size: 20rpx; color: #4F46E5; padding: 2rpx 10rpx; background: #EEF2FF; border-radius: 8rpx; }
