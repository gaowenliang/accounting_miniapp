<!-- pages/manage/manage.wxml — 管理 -->
<wxs src="../../utils/format.wxs" module="fmt"></wxs>
<view class="container">

  <!-- 概览卡片 -->
  <view class="overview-card">
    <text class="overview-emoji">💰</text>
    <text class="overview-name">记账达人</text>
    <view class="overview-stats">
      <view class="overview-stat">
        <text class="stat-num">{{totalBills}}</text>
        <text class="stat-label">总记录</text>
      </view>
      <view class="stat-divider"></view>
      <view class="overview-stat">
        <text class="stat-num">{{totalDays}}</text>
        <text class="stat-label">记账天数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="overview-stat">
        <text class="stat-num">¥{{fmt.fen2yuanInt(totalAssets)}}</text>
        <text class="stat-label">总资产</text>
      </view>
    </view>
  </view>

  <!-- 账本概况 -->
  <view class="ledger-overview-card">
    <view class="ledger-ov-header">
      <text class="ledger-ov-title">{{currentLedger.name || '账本'}}概况</text>
      <text class="ledger-ov-type" wx:if="{{currentLedger.type === 'shared'}}">👥 共享</text>
      <text class="ledger-ov-type" wx:else>📒 个人</text>
    </view>
    <view class="ledger-ov-row">
      <view class="ledger-ov-label">👤 成员人数</view>
      <text class="ledger-ov-value">{{overview.memberCount}}人</text>
    </view>
    <view class="ledger-ov-row" wx:if="{{overview.currencies.length > 0}}">
      <view class="ledger-ov-label">💱 货币种类</view>
      <view class="ledger-ov-currencies">
        <text class="ledger-ov-cur-item" wx:for="{{overview.currencies}}" wx:key="code">{{item.flag}} {{item.name}}</text>
      </view>
    </view>
    <view class="ledger-ov-row">
      <view class="ledger-ov-label">💸 支出汇总</view>
      <view class="ledger-ov-values">
        <text class="ledger-ov-amount">¥{{fmt.fen2yuan(overview.totalExpenseCNY)}}</text>
        <text class="ledger-ov-sub" wx:for="{{overview.expenseByCurrency}}" wx:key="code" wx:if="{{item.code !== 'CNY'}}">
          {{item.symbol}}{{fmt.fen2yuan(item.amount)}} {{item.name}}
        </text>
      </view>
    </view>
    <view class="ledger-ov-row">
      <view class="ledger-ov-label">💰 收入汇总</view>
      <text class="ledger-ov-amount income">¥{{fmt.fen2yuan(overview.totalIncomeCNY)}}</text>
    </view>
  </view>

  <!-- 账本管理 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📚 账本</text>
      <view class="header-actions">
        <text class="action-btn" bindtap="showJoin">加入</text>
        <text class="action-btn primary" bindtap="showCreateLedger">+ 新建</text>
      </view>
    </view>
    <view class="card">
      <view class="ledger-item {{currentLedger.id === item.id ? 'current' : ''}}"
            wx:for="{{ledgerList}}" wx:key="id"
            bindtap="switchLedgerTap" data-id="{{item.id}}"
            bindlongpress="goLedgerDetail" data-id="{{item.id}}">
        <text class="ledger-icon">{{item.icon}}</text>
        <view class="ledger-info">
          <text class="ledger-name">{{item.name}}</text>
          <text class="ledger-meta">{{item.type === 'shared' ? '共享·' + item.memberCount + '人' : '个人'}}</text>
        </view>
        <view class="ledger-check" wx:if="{{currentLedger.id === item.id}}">
          <text class="check-mark">✓</text>
        </view>
        <text class="ledger-arrow" wx:else>›</text>
      </view>
    </view>
  </view>

  <!-- 邀请（共享账本才显示） -->
  <view class="section" wx:if="{{currentLedger.type === 'shared' && currentLedger.role === 'owner'}}">
    <view class="card invite-card" bindtap="showInvite">
      <text class="invite-icon">🔗</text>
      <text class="invite-text">邀请成员加入「{{currentLedger.name}}」</text>
      <text class="invite-arrow">›</text>
    </view>
  </view>

  <!-- 账户管理 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">💳 账户</text>
    </view>
    <view class="card">
      <view class="account-row" wx:for="{{accounts}}" wx:key="id">
        <text class="account-icon">{{item.icon}}</text>
        <text class="account-name">{{item.name}}</text>
        <text class="account-balance {{item.balance >= 0 ? 'text-income' : 'text-expense'}}">
          ¥{{fmt.fen2yuan(item.balance || 0)}}
        </text>
      </view>
      <view class="add-btn" bindtap="addAccount">
        <text>＋ 添加账户</text>
      </view>
    </view>
  </view>

  <!-- 币种排序（可折叠） -->
  <view class="section">
    <view class="section-header collapsible" bindtap="toggleCurrencySort">
      <text class="section-title">🌍 币种排序</text>
      <text class="collapse-icon">{{showCurrencySort ? '▲' : '▼'}}</text>
    </view>
    <view class="card" wx:if="{{showCurrencySort}}">
      <view class="section-header" style="padding:0 0 10rpx;display:flex;justify-content:space-between;">
        <text class="action-btn" bindtap="refreshRates" wx:if="{{!refreshRatesLoading}}">🔄 更新汇率</text>
        <text class="action-btn" wx:else>更新中...</text>
        <text class="action-btn" bindtap="resetCurrencyOrder">恢复默认排序</text>
      </view>
      <text class="rate-updated-hint" wx:if="{{rateUpdatedAt}}">上次更新: {{rateUpdatedAt}}</text>
      <view class="currency-sort-item" wx:for="{{currencyList}}" wx:key="code">
        <text class="cs-flag">{{item.flag}}</text>
        <text class="cs-code">{{item.code}}</text>
        <text class="cs-name">{{item.name}}</text>
        <view class="cs-arrows">
          <text class="cs-arrow" bindtap="moveCurrencyUp" data-idx="{{index}}" wx:if="{{index > 0}}">↑</text>
          <text class="cs-arrow" bindtap="moveCurrencyDown" data-idx="{{index}}" wx:if="{{index < currencyList.length - 1}}">↓</text>
        </view>
      </view>
      <view style="padding:10rpx 0;color:#9CA3AF;font-size:20rpx;">顺序影响记账页币种排列 · 汇率可手动修改</view>
    </view>
  </view>

  <!-- 分类排序（可折叠） -->
  <view class="section">
    <view class="section-header collapsible" bindtap="toggleCatSort">
      <text class="section-title">📂 分类排序</text>
      <text class="collapse-icon">{{showCatSort ? '▲' : '▼'}}</text>
    </view>
    <view class="card" wx:if="{{showCatSort}}">
      <view class="section-header" style="padding:0 0 10rpx">
        <text class="action-btn {{catSortType === 'expense' ? 'active' : ''}}" bindtap="switchCatSort" data-type="expense">支出</text>
        <text class="action-btn {{catSortType === 'income' ? 'active' : ''}}" bindtap="switchCatSort" data-type="income">收入</text>
        <text class="action-btn" bindtap="resetCatOrder">恢复默认</text>
      </view>
      <view class="currency-sort-item" wx:for="{{catSortList}}" wx:key="key">
        <text class="cs-flag">{{item.icon}}</text>
        <text class="cs-name">{{item.name}}</text>
        <view class="cs-arrows">
          <text class="cs-arrow" bindtap="moveCatUp" data-idx="{{index}}" wx:if="{{index > 0}}">↑</text>
          <text class="cs-arrow" bindtap="moveCatDown" data-idx="{{index}}" wx:if="{{index < catSortList.length - 1}}">↓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 人员管理 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">👥 人员</text>
      <view class="header-actions">
        <text class="action-btn" bindtap="openGroupManager">分组管理</text>
        <text class="action-btn" bindtap="openHistoryImport">历史导入</text>
        <text class="action-btn" bindtap="openBatchAdd">批量添加</text>
        <text class="action-btn primary" bindtap="showAddMemberModal">+ 添加</text>
      </view>
    </view>
    <view class="card">
      <view class="member-row" wx:for="{{members}}" wx:key="id">
        <text class="member-avatar">{{item.avatar}}</text>
        <view class="member-info">
          <text class="member-name">{{item.name}}</text>
          <view class="member-groups" wx:if="{{item.groups && item.groups.length > 0}}">
            <text class="group-tag" wx:for="{{item.groups}}" wx:for-item="gname" wx:key="*this">{{gname}}</text>
          </view>
        </view>
        <text class="member-default" wx:if="{{item.isDefault}}">默认</text>
        <view class="member-actions" wx:if="{{!item.isDefault}}">
          <text class="member-action-btn" bindtap="openAssignGroup" data-id="{{item.id}}">分组</text>
          <text class="member-action-btn delete" bindtap="removeMember" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 预算 -->
  <view class="section">
    <view class="card">
      <view class="setting-row" bindtap="showBudgetSetting">
        <view class="setting-left">
          <text>📊</text>
          <text class="setting-label">月度预算</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{budgetEnabled ? '¥' + budgetAmountText : '未设置'}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      <view class="setting-row" wx:if="{{budgetEnabled}}" bindtap="disableBudget">
        <view class="setting-left">
          <text>🔕</text>
          <text class="setting-label">关闭预算</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分享功能 -->
  <view class="share-section">
    <button class="share-btn" open-type="share">
      <text class="share-icon">📤</text>
      <text class="share-text">分享给朋友</text>
    </button>
  </view>

  <!-- 其他 -->
  <view class="section">
    <view class="card">
      <view class="setting-row" bindtap="exportData">
        <view class="setting-left">
          <text>📤</text>
          <text class="setting-label">导出数据</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      <view class="setting-row" bindtap="backupData">
        <view class="setting-left">
          <text>💾</text>
          <text class="setting-label">备份数据</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      <view class="setting-row" bindtap="restoreData">
        <view class="setting-left">
          <text>📥</text>
          <text class="setting-label">恢复数据</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      <view class="setting-row" bindtap="showClearConfirm">
        <view class="setting-left">
          <text>🗑️</text>
          <text class="setting-label danger">清除所有数据</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 创建账本弹窗 -->
  <view class="modal-mask" wx:if="{{showLedgerModal}}" bindtap="cancelCreateLedger">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">新建账本</view>
      <view class="modal-body">
        <input class="form-input" placeholder="账本名称" value="{{newLedgerName}}" bindinput="onNewLedgerNameInput" />
        <view class="type-select">
          <view class="type-opt {{newLedgerType === 'personal' ? 'active' : ''}}" catchtap="switchLedgerType" data-type="personal">
            📒 个人账本
          </view>
          <view class="type-opt {{newLedgerType === 'shared' ? 'active' : ''}}" catchtap="switchLedgerType" data-type="shared">
            👥 共享账本
          </view>
        </view>
        <!-- 共享账本选项 -->
        <block wx:if="{{newLedgerType === 'shared'}}">
          <view class="shared-options">
            <view class="shared-opt-row">
              <text class="shared-opt-label">邀请码</text>
              <view class="shared-opt-toggles">
                <text class="shared-opt-btn {{newLedgerInviteMode === 'auto' ? 'active' : ''}}" catchtap="setInviteMode" data-mode="auto">自动生成</text>
                <text class="shared-opt-btn {{newLedgerInviteMode === 'custom' ? 'active' : ''}}" catchtap="setInviteMode" data-mode="custom">自定义</text>
                <text class="shared-opt-btn {{newLedgerInviteMode === 'off' ? 'active danger' : ''}}" catchtap="setInviteMode" data-mode="off">关闭</text>
              </view>
            </view>
            <input class="form-input shared-custom-code" wx:if="{{newLedgerInviteMode === 'custom'}}" placeholder="6位字母数字" value="{{newLedgerCustomCode}}" bindinput="onCustomCodeInput" maxlength="6" />
            <text class="modal-hint" wx:if="{{newLedgerInviteMode === 'auto'}}">系统自动生成6位邀请码</text>
            <text class="modal-hint" wx:if="{{newLedgerInviteMode === 'off'}}">只能通过你分享小程序卡片邀请</text>
          </view>
        </block>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelCreateLedger">取消</view>
        <view class="btn-primary" bindtap="confirmCreateLedger">创建</view>
      </view>
    </view>
  </view>

  <!-- 邀请弹窗 -->
  <view class="modal-mask" wx:if="{{showInviteModal}}" bindtap="cancelInvite">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">邀请成员</view>
      <view class="modal-body">
        <text class="invite-label">分享邀请码给需要加入的人</text>
        <view class="invite-code-box" bindtap="copyInviteCode">
          <text class="invite-code">{{inviteCode}}</text>
          <text class="invite-copy">点击复制</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-primary" bindtap="cancelInvite">关闭</view>
      </view>
    </view>
  </view>

  <!-- 加入弹窗 -->
  <view class="modal-mask" wx:if="{{showJoinModal}}" bindtap="cancelJoin">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">加入共享账本</view>
      <view class="modal-body">
        <input class="form-input" placeholder="输入6位邀请码" type="text" maxlength="6" value="{{joinCode}}" bindinput="onJoinCodeInput" focus="{{showJoinModal}}" />
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelJoin">取消</view>
        <view class="btn-primary" bindtap="confirmJoin">加入</view>
      </view>
    </view>
  </view>

  <!-- 预算弹窗 -->
  <view class="modal-mask" wx:if="{{showBudgetModal}}" bindtap="cancelBudget">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">设置月度预算</view>
      <view class="modal-body">
        <input class="form-input" type="digit" placeholder="输入预算金额" value="{{budgetInput}}" bindinput="onBudgetInput" focus="{{showBudgetModal}}" />
        <text class="modal-hint">支出达到80%时会提醒</text>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelBudget">取消</view>
        <view class="btn-primary" bindtap="saveBudget">确认</view>
      </view>
    </view>
  </view>

  <!-- 添加人员弹窗 -->
  <view class="modal-mask" wx:if="{{showMemberModal}}" bindtap="cancelAddMember">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">添加人员</view>
      <view class="modal-body">
        <input class="form-input" placeholder="输入姓名" value="{{newMemberName}}" bindinput="onMemberNameInput" focus="{{showMemberModal}}" />
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelAddMember">取消</view>
        <view class="btn-primary" bindtap="confirmAddMember">添加</view>
      </view>
    </view>
  </view>

  <!-- 批量添加成员弹窗 -->
  <view class="modal-mask" wx:if="{{showBatchAdd}}" bindtap="closeBatchAdd">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">批量添加成员</view>
      <view class="modal-body">
        <textarea class="batch-textarea" placeholder="每一行输入一个成员名&#10;例：&#10;小王&#10;小李&#10;小杨" value="{{batchNames}}" bindinput="onBatchInput" auto-height maxlength="1000" />
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="closeBatchAdd">取消</view>
        <view class="btn-primary" bindtap="saveBatchAdd">保存</view>
      </view>
    </view>
  </view>

  <!-- 从历史导入弹窗 -->
  <view class="modal-mask" wx:if="{{showHistoryImport}}" bindtap="closeHistoryImport">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">从历史导入</view>
      <view class="modal-body">
        <text class="modal-hint" style="margin-bottom: 16rpx;">选择要恢复的成员</text>
        <view class="history-list">
          <view class="history-item {{historySelected.indexOf(item.name) >= 0 ? 'selected' : ''}}"
                wx:for="{{deletedMembers}}" wx:key="name"
                bindtap="toggleHistoryItem" data-name="{{item.name}}">
            <text class="history-avatar">{{item.avatar}}</text>
            <text class="history-name">{{item.name}}</text>
            <view class="history-check" wx:if="{{historySelected.indexOf(item.name) >= 0}}">✓</view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="closeHistoryImport">取消</view>
        <view class="btn-primary" bindtap="confirmHistoryImport">导入({{historySelected.length}})</view>
      </view>
    </view>
  </view>

  <!-- 分组管理弹窗 -->
  <view class="modal-mask" wx:if="{{showGroupManager}}" bindtap="closeGroupManager">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">分组管理</view>
      <view class="modal-body">
        <!-- 创建分组 -->
        <view class="group-create-bar">
          <input class="group-input" placeholder="输入分组名" value="{{newGroupName}}" bindinput="onGroupNameInput" bindconfirm="createGroup" />
          <view class="group-create-btn" bindtap="createGroup">创建</view>
        </view>
        <!-- 分组列表 -->
        <view class="group-list" wx:if="{{memberGroups.length > 0}}">
          <view class="group-item" wx:for="{{memberGroups}}" wx:key="id">
            <view class="group-info">
              <text class="group-name">{{item.name}}</text>
              <text class="group-count">{{item.memberIds.length}}人</text>
            </view>
            <text class="group-del" bindtap="deleteGroup" data-id="{{item.id}}">删除</text>
          </view>
        </view>
        <view class="empty-tip" wx:else>
          <text>暂无分组，创建一个吧</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-primary" bindtap="closeGroupManager">关闭</view>
      </view>
    </view>
  </view>

  <!-- 分配分组弹窗 -->
  <view class="modal-mask" wx:if="{{showAssignGroup}}" bindtap="closeAssignGroup">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">分配到分组</view>
      <view class="modal-body">
        <view class="group-assign-list" wx:if="{{memberGroups.length > 0}}">
          <view class="group-assign-item" wx:for="{{memberGroups}}" wx:key="id" bindtap="toggleMemberGroup" data-id="{{item.id}}">
            <view class="group-assign-check {{item.memberIds.indexOf(assigningMemberId) >= 0 ? 'checked' : ''}}">
              {{item.memberIds.indexOf(assigningMemberId) >= 0 ? '✓' : ''}}
            </view>
            <text>{{item.name}}</text>
          </view>
        </view>
        <view class="empty-tip" wx:else>
          <text>请先创建分组</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-primary" bindtap="closeAssignGroup">完成</view>
      </view>
    </view>
  </view>

  <!-- 错误日志 -->
  <view class="section" wx:if="{{errorLogs.length > 0}}">
    <view class="card">
      <view class="setting-row" bindtap="showErrorLog">
        <view class="setting-left">
          <text>🐛</text>
          <text class="setting-label">错误日志</text>
        </view>
        <view class="setting-right">
          <text class="setting-value warn">{{errorLogs.length}}条</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 错误日志弹窗 -->
  <view class="modal-mask" wx:if="{{showErrorModal}}" bindtap="closeErrorLog">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">🐛 错误日志</view>
      <view class="modal-body" style="max-height: 60vh; overflow-y: auto;">
        <view class="error-log-item" wx:for="{{errorLogs}}" wx:key="index">
          <view class="error-log-header">
            <text class="error-log-type">{{item.type}}</text>
            <text class="error-log-page">{{item.page}}</text>
          </view>
          <text class="error-log-msg">{{item.error}}</text>
          <text class="error-log-time">{{item.timeText}}</text>
        </view>
        <view class="empty-tip" wx:if="{{errorLogs.length === 0}}">
          <text>暂无错误 🎉</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="clearErrorLog">清除日志</view>
        <view class="btn-primary" bindtap="closeErrorLog">关闭</view>
      </view>
    </view>
  </view>

  <!-- 清除确认 -->
  <view class="modal-mask" wx:if="{{showClearModal}}" bindtap="cancelClear">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header danger">⚠️ 清除所有数据</view>
      <view class="modal-body">
        <text class="modal-warn">此操作不可恢复！所有账单、账户、预算数据将被清除。</text>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelClear">取消</view>
        <view class="btn-danger" bindtap="clearAllData">确认清除</view>
      </view>
    </view>
  </view>

</view>
