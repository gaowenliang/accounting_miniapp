/* pages/manage/manage.wxss — 靛蓝主题 */

/* 概览 */
.overview-card {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  border-radius: 24rpx; padding: 32rpx 28rpx; margin-bottom: 20rpx;
  display: flex; flex-direction: column; align-items: center; color: #FFF;
  box-shadow: 0 8rpx 32rpx rgba(79,70,229,0.25);
}
.overview-emoji { font-size: 56rpx; margin-bottom: 6rpx; }
.overview-name { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.overview-stats { display: flex; width: 100%; }
.overview-stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 28rpx; font-weight: 700; }
.stat-label { font-size: 20rpx; opacity: 0.7; margin-top: 4rpx; }
.stat-divider { width: 1rpx; height: 32rpx; background: rgba(255,255,255,0.15); }

/* 区块 */
.section { margin-bottom: 20rpx; }
.section-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 4rpx 4rpx 10rpx;
}
.section-title { font-size: 28rpx; font-weight: 700; color: #1F2937; }
.header-actions { display: flex; gap: 16rpx; }
.action-btn { font-size: 24rpx; color: #6B7280; padding: 4rpx 8rpx; }
.action-btn.primary { color: #4F46E5; font-weight: 600; }
.action-btn.active { color: #4F46E5; font-weight: 600; background: #EEF2FF; border-radius: 8rpx; }
.collapse-icon { font-size: 22rpx; color: #9CA3AF; }
.section-header.collapsible { cursor: pointer; }

/* 账本 */
.card {
  background: #FFFFFF; border-radius: 20rpx; padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(79,70,229,0.05);
}
.ledger-item {
  display: flex; align-items: center; padding: 18rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.ledger-item:last-child { border-bottom: none; }
.ledger-item.current { background: #EEF2FF; border-radius: 14rpx; padding: 18rpx 16rpx; margin: 0 -16rpx; }
.ledger-icon { font-size: 32rpx; margin-right: 14rpx; }
.ledger-info { flex: 1; display: flex; flex-direction: column; }
.ledger-name { font-size: 28rpx; font-weight: 600; color: #1F2937; }
.ledger-meta { font-size: 22rpx; color: #9CA3AF; margin-top: 2rpx; }
.ledger-check { margin-left: 12rpx; }
.check-mark { color: #4F46E5; font-size: 28rpx; font-weight: 700; }
.ledger-arrow { font-size: 28rpx; color: #D1D5DB; margin-left: 12rpx; }

/* 邀请 */
.invite-card {
  display: flex; align-items: center; padding: 18rpx 24rpx;
}
.invite-icon { font-size: 28rpx; margin-right: 12rpx; }
.invite-text { flex: 1; font-size: 26rpx; color: #4F46E5; font-weight: 500; }
.invite-arrow { font-size: 28rpx; color: #D1D5DB; }

/* 账户 */
.account-row {
  display: flex; align-items: center; padding: 14rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.account-row:last-of-type { border-bottom: none; }
.account-icon { font-size: 28rpx; margin-right: 12rpx; }
.account-name { flex: 1; font-size: 26rpx; color: #374151; }
.account-balance { font-size: 24rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.add-btn { text-align: center; padding: 16rpx; color: #4F46E5; font-size: 24rpx; font-weight: 500; }

/* 人员管理 */
.member-row {
  display: flex; align-items: center; padding: 14rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.member-row:last-child { border-bottom: none; }
.member-avatar { font-size: 28rpx; margin-right: 10rpx; }
.member-info { flex: 1; display: flex; flex-direction: column; }
.member-name { font-size: 26rpx; color: #1F2937; }
.member-default { font-size: 20rpx; color: #4F46E5; background: #EEF2FF; padding: 2rpx 12rpx; border-radius: 8rpx; }
.member-actions { display: flex; gap: 12rpx; }
.member-action-btn { font-size: 22rpx; color: #6B7280; padding: 4rpx 12rpx; }
.member-action-btn.delete { color: #EF4444; }
.member-remove { font-size: 22rpx; color: #EF4444; }

/* 分组标签 */
.member-groups { display: flex; gap: 6rpx; margin-top: 4rpx; }
.group-tag {
  font-size: 18rpx; color: #4F46E5; background: #EEF2FF;
  padding: 2rpx 10rpx; border-radius: 6rpx;
}

/* 分组管理弹窗 */
.group-create-bar { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.group-input {
  flex: 1; background: #F3F4F6; border-radius: 8rpx;
  padding: 12rpx 16rpx; font-size: 28rpx;
}
.group-create-btn {
  background: #4F46E5; color: #fff; padding: 12rpx 24rpx;
  border-radius: 8rpx; font-size: 28rpx; text-align: center;
  display: flex; align-items: center;
}
.group-list { margin-top: 12rpx; }
.group-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 0; border-bottom: 1rpx solid #F3F4F6;
}
.group-info { display: flex; gap: 12rpx; align-items: center; }
.group-name { font-size: 28rpx; color: #1F2937; }
.group-count { font-size: 22rpx; color: #9CA3AF; }
.group-del { font-size: 24rpx; color: #EF4444; }

.group-assign-list { margin: 16rpx 0; }
.group-assign-item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 0; border-bottom: 1rpx solid #F3F4F6;
}
.group-assign-check {
  width: 36rpx; height: 36rpx; border-radius: 8rpx;
  border: 2rpx solid #D1D5DB; display: flex; align-items: center;
  justify-content: center; font-size: 20rpx; color: #fff;
}
.group-assign-check.checked {
  background: #4F46E5; border-color: #4F46E5;
}
.empty-tip { text-align: center; padding: 32rpx; color: #9CA3AF; font-size: 26rpx; }

/* 设置 */
.setting-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid #F3F4F6;
}
.setting-row:last-child { border-bottom: none; }
.setting-left { display: flex; align-items: center; gap: 8rpx; }
.setting-label { font-size: 26rpx; color: #374151; }
.setting-label.danger { color: #EF4444; }
.setting-right { display: flex; align-items: center; }
.setting-value { font-size: 24rpx; color: #9CA3AF; margin-right: 8rpx; }
.setting-arrow { font-size: 28rpx; color: #D1D5DB; }

/* 弹窗 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex;
  align-items: center; justify-content: center; z-index: 999;
}
.modal-content { width: 82%; background: #FFF; border-radius: 28rpx; overflow: hidden; }
.modal-header { text-align: center; font-size: 32rpx; font-weight: 700; color: #1F2937; padding: 36rpx 28rpx 12rpx; }
.modal-header.danger { color: #EF4444; }
.modal-body { padding: 16rpx 36rpx 28rpx; }
.form-input {
  border: 2rpx solid #E5E7EB; border-radius: 16rpx;
  padding: 20rpx; font-size: 28rpx; background: #F9FAFB;
}
.modal-hint { font-size: 22rpx; color: #9CA3AF; margin-top: 12rpx; display: block; }
.modal-warn { font-size: 26rpx; color: #EF4444; line-height: 1.6; }
.modal-footer { display: flex; border-top: 1rpx solid #F3F4F6; }
.modal-footer view { flex: 1; text-align: center; padding: 28rpx; font-size: 30rpx; }
.btn-cancel { color: #6B7280; }
.btn-primary { color: #4F46E5; font-weight: 700; }
.btn-danger { color: #EF4444; font-weight: 700; }

.type-select { display: flex; gap: 12rpx; margin-top: 16rpx; }
.type-opt {
  flex: 1; text-align: center; padding: 16rpx; border-radius: 16rpx;
  background: #F3F4F6; font-size: 24rpx; color: #6B7280;
}
.type-opt.active { background: #EEF2FF; color: #4F46E5; font-weight: 600; border: 2rpx solid #4F46E5; }

.invite-label { font-size: 24rpx; color: #9CA3AF; display: block; margin-bottom: 16rpx; }
.invite-code-box { text-align: center; padding: 32rpx; background: #F9FAFB; border-radius: 16rpx; }
.invite-code { font-size: 48rpx; font-weight: 700; color: #4F46E5; letter-spacing: 12rpx; display: block; }
.invite-copy { font-size: 22rpx; color: #9CA3AF; margin-top: 8rpx; display: block; }

/* 币种排序 */
.currency-sort-item {
  display: flex; align-items: center; padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}
.cs-flag { font-size: 28rpx; margin-right: 10rpx; }
.cs-code { font-size: 26rpx; font-weight: 600; color: #1F2937; width: 60rpx; }
.cs-name { flex: 1; font-size: 24rpx; color: #6B7280; }
.cs-arrows { display: flex; gap: 16rpx; }
.cs-arrow {
  font-size: 28rpx; color: #4F46E5; padding: 8rpx 16rpx;
  background: #EEF2FF; border-radius: 12rpx; font-weight: 600;
}

/* 批量添加 */
.batch-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #E5E7EB;
  box-sizing: border-box;
}

/* 历史导入 */
.history-list {
  max-height: 500rpx;
  overflow-y: auto;
}
.history-item {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
  border-radius: 12rpx;
}
.history-item.selected {
  background: #EEF2FF;
}
.history-item:last-child {
  border-bottom: none;
}
.history-avatar {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.history-name {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
}
.history-check {
  color: #4F46E5;
  font-size: 28rpx;
  font-weight: 700;
}

/* 分享 */
.share-section {
  padding: 20rpx;
  margin-top: 20rpx;
}
.share-btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  background: #4F46E5; color: #fff; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; border: none;
  width: 100%;
}
.share-btn::after { border: none; }
.share-icon { font-size: 32rpx; }
.share-text { font-size: 28rpx; }

/* 账本概况卡片 */
.ledger-overview-card {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #fff;
}
.ledger-ov-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}
.ledger-ov-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 8rpx 0;
  font-size: 24rpx;
}
.ledger-ov-label {
  opacity: 0.85;
  flex-shrink: 0;
}
.ledger-ov-value {
  font-weight: 500;
}
.ledger-ov-currencies {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6rpx;
}
.ledger-ov-cur-item {
  font-size: 22rpx;
}
.ledger-ov-values {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.ledger-ov-amount {
  font-weight: 600;
  font-size: 28rpx;
}
.ledger-ov-sub {
  font-size: 20rpx;
  opacity: 0.7;
  margin-top: 2rpx;
}
.ledger-ov-amount.income {
  color: #86EFAC;
}

/* 错误日志 */
.setting-value.warn { color: #EF4444; }
.error-log-item {
  background: #FEF2F2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.error-log-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.error-log-type {
  font-size: 22rpx;
  font-weight: 600;
  color: #EF4444;
}
.error-log-page {
  font-size: 20rpx;
  color: #9CA3AF;
}
.error-log-msg {
  font-size: 22rpx;
  color: #374151;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.error-log-time {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
  display: block;
}

/* 共享账本选项 */
.shared-options { margin-top: 20rpx; padding: 16rpx; background: #F9FAFB; border-radius: 16rpx; }
.shared-opt-row { display: flex; align-items: center; justify-content: space-between; }
.shared-opt-label { font-size: 24rpx; font-weight: 600; color: #6B7280; }
.shared-opt-toggles { display: flex; gap: 8rpx; }
.shared-opt-btn { font-size: 20rpx; padding: 6rpx 16rpx; border-radius: 20rpx; background: #FFF; color: #9CA3AF; border: 2rpx solid #E5E7EB; }
.shared-opt-btn.active { background: #EEF2FF; color: #4F46E5; border-color: #4F46E5; font-weight: 600; }
.shared-opt-btn.active.danger { background: #FEE2E2; color: #EF4444; border-color: #EF4444; }
.shared-custom-code { margin-top: 12rpx; text-align: center; letter-spacing: 8rpx; font-size: 32rpx; font-weight: 700; text-transform: uppercase; }
.ledger-ov-header { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.ledger-ov-type { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: #F3F4F6; color: #6B7280; }
