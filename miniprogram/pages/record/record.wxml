<!-- pages/record/record.wxml — 记账页 -->
<view class="container">

  <!-- 收入/支出切换 + 金额 -->
  <view class="type-amount">
    <view class="type-switch">
      <view class="type-btn {{billType === 'expense' ? 'active expense' : ''}}" bindtap="switchType" data-type="expense">支出</view>
      <view class="type-btn {{billType === 'income' ? 'active income' : ''}}" bindtap="switchType" data-type="income">收入</view>
    </view>
    <view class="amount-display">
      <text class="amount-symbol">{{currencySymbol}}</text>
      <text class="amount-value">{{amountStr || '0'}}</text>
      <view class="cursor" wx:if="{{!amountStr}}"></view>
    </view>
  </view>

  <!-- 币种 -->
  <view class="section-flat">
    <text class="flat-label">币种</text>
    <scroll-view class="currency-scroll" scroll-x enable-flex>
      <view class="currency-item {{selectedCurrency === item.code ? 'selected' : ''}}"
            wx:for="{{currencies}}" wx:key="code"
            bindtap="selectCurrency" data-code="{{item.code}}">
        <text class="currency-flag">{{item.flag}}</text>
        <text class="currency-code">{{item.code}}</text>
      </view>
    </scroll-view>
    <view class="exchange-info" wx:if="{{selectedCurrency !== 'CNY'}}">
      <text class="exchange-text">{{rateDisplay}} → ≈¥{{amountCNYText}}</text>
    </view>
  </view>

  <!-- 分类：前8个 + 更多 -->
  <view class="section-flat">
    <text class="flat-label">分类</text>
    <view class="category-grid">
      <view class="cat-item {{selectedCategory === item.key ? 'selected' : ''}}"
            wx:for="{{topCategories}}" wx:key="key"
            bindtap="selectCategory" data-key="{{item.key}}">
        <text class="cat-icon">{{item.icon}}</text>
        <text class="cat-name">{{item.name}}</text>
      </view>
      <!-- 更多/收起 -->
      <view class="cat-item cat-more" bindtap="toggleMoreCategories">
        <text class="cat-icon">{{showMoreCategories ? '▲' : '···'}}</text>
        <text class="cat-name">{{showMoreCategories ? '收起' : '更多'}}</text>
      </view>
    </view>
    <!-- 展开的更多分类 -->
    <view class="category-grid" wx:if="{{showMoreCategories}}">
      <view class="cat-item {{selectedCategory === item.key ? 'selected' : ''}}"
            wx:for="{{moreCategories}}" wx:key="key"
            bindtap="selectCategory" data-key="{{item.key}}">
        <text class="cat-icon">{{item.icon}}</text>
        <text class="cat-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section-flat">
    <input class="note-input-main" placeholder="添加备注..." value="{{note}}" bindinput="onNoteInput" maxlength="200" />
  </view>

  <!-- 花费人 -->
  <view class="section-flat">
    <text class="flat-label">花费人</text>
    <scroll-view class="payer-scroll" scroll-x enable-flex>
      <view class="person-item {{selectedPayer === item.id ? 'selected' : ''}}"
            wx:for="{{members}}" wx:key="id"
            bindtap="pickPayer" data-id="{{item.id}}">
        <text class="person-avatar">{{item.avatar}}</text>
        <text class="person-name">{{item.name}}</text>
      </view>
      <view class="person-item add" bindtap="showAddMember">
        <text class="person-avatar">＋</text>
        <text class="person-name">添加</text>
      </view>
    </scroll-view>
  </view>

  <!-- 分摊（仅支出且多人时显示） -->
  <view class="section-flat" wx:if="{{billType === 'expense' && members.length > 1}}">
    <text class="flat-label">分摊</text>
    <view class="split-bar">
      <view class="split-opt {{splitMode === 'no_split' ? 'active' : ''}}" bindtap="setSplitNoSplit">不分摊</view>
      <view class="split-opt {{splitMode === 'equal' ? 'active' : ''}}" bindtap="setSplitEqual">AA均摊</view>
      <view class="split-opt {{splitMode === 'ratio' ? 'active' : ''}}" bindtap="setSplitRatio">按比例</view>
      <view class="split-opt {{splitMode === 'custom' ? 'active' : ''}}" bindtap="setSplitCustom">自定义</view>
    </view>
    <view class="split-preview-area" wx:if="{{splitMode === 'equal'}}">
      <text class="split-preview-text">每人 {{currencySymbol}}{{splitPerPerson}}</text>
    </view>
    <view class="custom-splits" wx:if="{{splitMode === 'ratio' || splitMode === 'custom'}}">
      <view class="split-input-row" wx:for="{{splitItems}}" wx:key="memberId">
        <text class="split-input-avatar">{{item.avatar}}</text>
        <text class="split-input-name">{{item.name}}</text>
        <text class="split-input-unit" wx:if="{{splitMode === 'ratio'}}">占比</text>
        <text class="split-input-unit" wx:if="{{splitMode === 'custom'}}">{{currencySymbol}}</text>
        <input class="split-input" type="digit" placeholder="{{splitMode === 'ratio' ? '比例' : '0'}}"
               value="{{item.inputStr}}" bindinput="onSplitAmountInput" data-idx="{{index}}" />
      </view>
      <text class="split-remain" wx:if="{{splitRemainder !== 0}}">
        {{splitRemainder > 0 ? '还差' : '多了'}} {{currencySymbol}}{{(Math.abs(splitRemainder)/100).toFixed(2)}}
      </text>
      <text class="split-preview-text" wx:if="{{splitMode === 'ratio' && ratioTotal > 0}}">
        <block wx:for="{{splitItems}}" wx:key="memberId">
          {{item.name}} {{(item.amount / ratioTotal * 100).toFixed(1)}}% → {{currencySymbol}}{{(item.amount / ratioTotal * totalAmountFen / 100).toFixed(2)}}　
        </block>
      </text>
    </view>
  </view>

  <!-- 自定义数字键盘 -->
  <view class="keyboard {{billType === 'expense' ? 'kb-expense' : 'kb-income'}}">
    <view class="kb-toolbar">
      <view class="kb-toolbar-item" bindtap="pickDate">
        <text class="kb-toolbar-icon">📅</text>
        <text class="kb-toolbar-text">{{dateText}}</text>
      </view>
      <view class="kb-toolbar-item" bindtap="pickAccount">
        <text class="kb-toolbar-icon">💳</text>
        <text class="kb-toolbar-text">{{accountName}}</text>
      </view>
    </view>
    <view class="keypad">
      <view class="key" bindtap="pressKey" data-val="1" hover-class="key-hover">1</view>
      <view class="key" bindtap="pressKey" data-val="2" hover-class="key-hover">2</view>
      <view class="key" bindtap="pressKey" data-val="3" hover-class="key-hover">3</view>
      <view class="key key-del" bindtap="pressKey" data-val="del" hover-class="key-hover">⌫</view>
      <view class="key" bindtap="pressKey" data-val="4" hover-class="key-hover">4</view>
      <view class="key" bindtap="pressKey" data-val="5" hover-class="key-hover">5</view>
      <view class="key" bindtap="pressKey" data-val="6" hover-class="key-hover">6</view>
      <view class="key key-func" bindtap="pressKey" data-val="+" hover-class="key-hover">+</view>
      <view class="key" bindtap="pressKey" data-val="7" hover-class="key-hover">7</view>
      <view class="key" bindtap="pressKey" data-val="8" hover-class="key-hover">8</view>
      <view class="key" bindtap="pressKey" data-val="9" hover-class="key-hover">9</view>
      <view class="key key-func" bindtap="pressKey" data-val="-" hover-class="key-hover">−</view>
      <view class="key" bindtap="pressKey" data-val="." hover-class="key-hover">.</view>
      <view class="key" bindtap="pressKey" data-val="0" hover-class="key-hover">0</view>
      <view class="key" bindtap="pressKey" data-val="00" hover-class="key-hover">00</view>
      <view class="key key-ok" bindtap="pressKey" data-val="ok" hover-class="key-hover-ok">完成</view>
    </view>
  </view>

  <!-- 账户选择弹窗 -->
  <view class="modal-mask" wx:if="{{showAccountPicker}}" bindtap="closeAccountPicker">
    <view class="modal-content" catchtap="">
      <view class="modal-header">付款账户</view>
      <view class="modal-body account-list">
        <view class="account-item {{selectedAccount === item.key ? 'selected' : ''}}"
              wx:for="{{accounts}}" wx:key="key"
              bindtap="selectAccount" data-key="{{item.key}}">
          <text class="account-icon">{{item.icon}}</text>
          <text class="account-name">{{item.name}}</text>
          <text class="account-check" wx:if="{{selectedAccount === item.key}}">✓</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-primary" bindtap="closeAccountPicker" style="width:100%">确定</view>
      </view>
    </view>
  </view>

  <!-- 添加人员弹窗 -->
  <view class="modal-mask" wx:if="{{showAddMemberModal}}" bindtap="cancelAddMember">
    <view class="modal-content" catchtap="">
      <view class="modal-header">添加人员</view>
      <view class="modal-body">
        <input class="form-input" placeholder="输入姓名" value="{{newMemberName}}" bindinput="onNewMemberNameInput" focus="{{showAddMemberModal}}" />
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="cancelAddMember">取消</view>
        <view class="btn-primary" bindtap="confirmAddMember">添加</view>
      </view>
    </view>
  </view>

</view>
