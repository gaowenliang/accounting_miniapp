/* pages/record/record.wxss — 全平铺版 */

.container {
  display: flex; flex-direction: column; height: 100vh;
  padding: 0; background: #F7F7FA;
}

/* ===== 收支 + 金额 ===== */
.type-amount {
  padding: 20rpx 28rpx 12rpx; background: #FFF;
  box-shadow: 0 2rpx 12rpx rgba(79,70,229,0.04);
}
.type-switch {
  display: flex; background: #F3F4F6; border-radius: 44rpx; padding: 3rpx;
  margin-bottom: 16rpx;
}
.type-btn {
  flex: 1; text-align: center; padding: 12rpx 0; border-radius: 44rpx;
  font-size: 26rpx; font-weight: 600; color: #9CA3AF;
}
.type-btn.active.expense { background: linear-gradient(135deg, #EF4444, #F87171); color: #FFF; }
.type-btn.active.income { background: linear-gradient(135deg, #10B981, #34D399); color: #FFF; }

.amount-display {
  display: flex; align-items: baseline; justify-content: center;
  padding: 8rpx 0 12rpx;
}
.amount-symbol { font-size: 36rpx; font-weight: 700; color: #1F2937; margin-right: 8rpx; }
.amount-value { font-size: 64rpx; font-weight: 700; color: #1F2937; font-variant-numeric: tabular-nums; }
.cursor { width: 3rpx; height: 48rpx; background: #4F46E5; animation: blink 1s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

/* ===== 平铺区块 ===== */
.section-flat {
  padding: 12rpx 28rpx; background: #FFF; margin-top: 8rpx;
}
.flat-label {
  font-size: 22rpx; font-weight: 600; color: #9CA3AF;
  margin-bottom: 8rpx; display: block;
}

/* 分类横向滚动 */
.category-scroll { white-space: nowrap; }
.cat-item {
  display: inline-flex; flex-direction: column; align-items: center;
  margin-right: 20rpx; padding: 6rpx 4rpx; min-width: 72rpx;
}
.cat-icon { font-size: 32rpx; margin-bottom: 2rpx; }
.cat-name { font-size: 18rpx; color: #6B7280; }
.cat-item.selected .cat-icon { transform: scale(1.15); }
.cat-item.selected .cat-name { color: #4F46E5; font-weight: 600; }
.cat-item.selected::after {
  content: ''; display: block; width: 24rpx; height: 4rpx;
  background: #4F46E5; border-radius: 2rpx; margin-top: 2rpx;
}

/* 花费人横向滚动 */
.payer-scroll { white-space: nowrap; }
.person-item {
  display: inline-flex; flex-direction: column; align-items: center;
  margin-right: 16rpx; padding: 6rpx 12rpx; border-radius: 16rpx;
  background: #F9FAFB; transition: all 0.15s;
}
.person-item.selected { background: #EEF2FF; border: 2rpx solid #4F46E5; }
.person-item.add { border: 2rpx dashed #D1D5DB; background: transparent; }
.person-avatar { font-size: 28rpx; margin-bottom: 2rpx; }
.person-name { font-size: 18rpx; color: #6B7280; }
.person-item.selected .person-name { color: #4F46E5; font-weight: 600; }

/* 分摊方式 */
.split-bar { display:flex; align-items:center; gap:8rpx; flex-wrap:wrap; }
.split-opt { padding:8rpx 20rpx; border-radius:20rpx; background:#F3F4F6; font-size:24rpx; color:#6B7280; }
.split-opt.active { background:#4F46E5; color:#FFF; font-weight:600; }
.split-preview-area { margin-top:8rpx; }
.split-preview-text { font-size:24rpx; color:#4F46E5; font-weight:500; display:block; line-height:1.5; }

.custom-splits { margin-top:10rpx; }
.split-input-row {
  display:flex; align-items:center; padding:6rpx 0;
  border-bottom:1rpx solid #F3F4F6;
}
.split-input-avatar { font-size:24rpx; margin-right:6rpx; }
.split-input-name { font-size:22rpx; color:#374151; width:50rpx; }
.split-input-unit { font-size:20rpx; color:#9CA3AF; margin-right:4rpx; }
.split-input {
  flex:1; font-size:22rpx; text-align:right;
  border:1rpx solid #E5E7EB; border-radius:10rpx;
  padding:6rpx 12rpx; background:#F9FAFB;
}
.split-remain { font-size:20rpx; color:#EF4444; text-align:center; display:block; margin-top:4rpx; }

/* 备注 */
.note-section {
  padding: 12rpx 28rpx; background: #FFF; margin-top: 8rpx;
}
.note-input { font-size: 26rpx; color: #374151; width: 100%; }

/* ===== 键盘 ===== */
.keyboard {
  margin-top: auto; background: #E5E7EB;
  padding-bottom: env(safe-area-inset-bottom);
}
.kb-expense { border-top: 3rpx solid #EF4444; }
.kb-income { border-top: 3rpx solid #10B981; }

.keypad {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 4rpx; padding: 8rpx 8rpx 8rpx;
}
.key {
  display: flex; align-items: center; justify-content: center;
  background: #FFF; border-radius: 12rpx; height: 88rpx;
  font-size: 36rpx; font-weight: 500; color: #1F2937;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
}
.key-hover { background: #D1D5DB; }
.key-del { font-size: 28rpx; color: #6B7280; }
.key-ok {
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #FFF; font-size: 28rpx; font-weight: 700;
}
.kb-expense .key-ok { background: linear-gradient(135deg, #EF4444, #F87171); }
.kb-income .key-ok { background: linear-gradient(135deg, #10B981, #34D399); }

/* 弹窗 */
.modal-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.4); display:flex; align-items:center; justify-content:center; z-index:999; }
.modal-content { width:80%; background:#FFF; border-radius:28rpx; overflow:hidden; }
.modal-header { text-align:center; font-size:32rpx; font-weight:700; color:#1F2937; padding:36rpx 28rpx 12rpx; }
.modal-body { padding:16rpx 36rpx 28rpx; }
.form-input { border:2rpx solid #E5E7EB; border-radius:16rpx; padding:20rpx; font-size:28rpx; background:#F9FAFB; }
.modal-footer { display:flex; border-top:1rpx solid #F3F4F6; }
.modal-footer view { flex:1; text-align:center; padding:28rpx; font-size:30rpx; }
.btn-cancel { color:#6B7280; }
.btn-primary { color:#4F46E5; font-weight:700; }
