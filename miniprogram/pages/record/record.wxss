/* pages/record/record.wxss — 自定义键盘版 */

.container {
  display: flex; flex-direction: column; height: 100vh;
  padding: 0; background: #F7F7FA;
}

/* 顶部 */
.top-bar {
  padding: 16rpx 28rpx 8rpx;
}
.ledger-info {
  display: flex; align-items: center; gap: 8rpx;
  background: #FFF; padding: 10rpx 20rpx; border-radius: 44rpx;
  box-shadow: 0 2rpx 12rpx rgba(79,70,229,0.06);
}
.ledger-icon { font-size: 28rpx; }
.ledger-name { font-size: 26rpx; font-weight: 600; color: #1F2937; }
.ledger-arrow { font-size: 18rpx; color: #9CA3AF; }

/* 收支切换 */
.type-switch {
  display: flex; background: #F3F4F6; border-radius: 44rpx;
  padding: 4rpx; margin: 0 28rpx 16rpx;
}
.type-btn {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 44rpx;
  font-size: 28rpx; font-weight: 600; color: #9CA3AF;
}
.type-btn.active.expense { background: linear-gradient(135deg, #EF4444, #F87171); color: #FFF; }
.type-btn.active.income { background: linear-gradient(135deg, #10B981, #34D399); color: #FFF; }

/* 输入区 */
.input-area {
  background: #FFF; margin: 0 20rpx 12rpx; border-radius: 20rpx;
  padding: 20rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(79,70,229,0.05);
}

.amount-row {
  display: flex; align-items: center; padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
}
.category-badge {
  display: flex; align-items: center; gap: 6rpx;
  background: #EEF2FF; padding: 8rpx 16rpx; border-radius: 32rpx;
  margin-right: 16rpx; flex-shrink: 0;
}
.category-badge-icon { font-size: 28rpx; }
.category-badge-name { font-size: 24rpx; font-weight: 600; color: #4F46E5; }
.category-badge-arrow { font-size: 16rpx; color: #6366F1; }

.amount-display {
  flex: 1; display: flex; align-items: baseline; justify-content: flex-end;
  min-height: 64rpx;
}
.amount-symbol {
  font-size: 36rpx; font-weight: 700; color: #1F2937; margin-right: 8rpx;
}
.amount-value {
  font-size: 60rpx; font-weight: 700; color: #1F2937;
  font-variant-numeric: tabular-nums;
}
.amount-cursor {
  width: 4rpx; height: 48rpx; background: #4F46E5;
  animation: blink 1s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

.note-row { padding: 12rpx 0; }
.note-input {
  font-size: 26rpx; color: #374151; width: 100%;
}

/* 快捷选项 */
.quick-options {
  display: flex; gap: 12rpx; padding-top: 12rpx;
  border-top: 1rpx solid #F3F4F6;
}
.quick-opt {
  display: flex; align-items: center; gap: 4rpx;
  background: #F9FAFB; padding: 6rpx 14rpx; border-radius: 20rpx;
}
.quick-opt-icon { font-size: 22rpx; }
.quick-opt-text { font-size: 22rpx; color: #6B7280; }

/* 分类面板 */
.category-panel {
  background: #FFF; margin: 0 20rpx 12rpx; border-radius: 20rpx;
  padding: 16rpx; box-shadow: 0 2rpx 12rpx rgba(79,70,229,0.05);
}
.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; }
.category-item {
  display: flex; flex-direction: column; align-items: center;
  padding: 12rpx 4rpx; border-radius: 16rpx;
  background: #F9FAFB; transition: all 0.15s;
}
.category-item.selected { background: #EEF2FF; border: 2rpx solid #4F46E5; }
.category-icon { font-size: 32rpx; margin-bottom: 4rpx; }
.category-name { font-size: 20rpx; color: #6B7280; }
.category-item.selected .category-name { color: #4F46E5; font-weight: 600; }

/* ========== 自定义键盘 ========== */
.keyboard {
  margin-top: auto; background: #E5E7EB;
  padding-bottom: env(safe-area-inset-bottom);
}
.keyboard-expense { border-top: 4rpx solid #EF4444; }
.keyboard-income { border-top: 4rpx solid #10B981; }

/* 快捷金额 */
.quick-amounts {
  display: flex; padding: 12rpx 12rpx 6rpx; gap: 8rpx;
}
.quick-amount {
  flex: 1; text-align: center; padding: 10rpx 0;
  background: #FFF; border-radius: 12rpx;
  font-size: 24rpx; font-weight: 600; color: #4F46E5;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
}

/* 按键 */
.keypad {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 4rpx; padding: 6rpx 8rpx 8rpx;
}
.key {
  display: flex; align-items: center; justify-content: center;
  background: #FFF; border-radius: 12rpx;
  height: 88rpx; font-size: 36rpx; font-weight: 500;
  color: #1F2937; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
  transition: background 0.1s;
}
.key-hover { background: #D1D5DB; }

/* 确认按钮跨行 */
.key[val="ok"] {
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #FFF; font-size: 28rpx; font-weight: 700;
}
.keyboard-expense .key[val="ok"] {
  background: linear-gradient(135deg, #EF4444, #F87171);
}
.keyboard-income .key[val="ok"] {
  background: linear-gradient(135deg, #10B981, #34D399);
}
.key[val="del"] { font-size: 32rpx; color: #6B7280; }

/* 人员弹窗 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex;
  align-items: flex-end; justify-content: center; z-index: 999;
}
.modal-slide {
  width: 100%; background: #FFF; border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.slide-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid #F3F4F6;
}
.slide-title { font-size: 32rpx; font-weight: 700; color: #1F2937; }
.slide-close { font-size: 28rpx; color: #4F46E5; font-weight: 600; }

.payer-list { padding: 16rpx 32rpx; }
.payer-option {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.payer-option:last-child { border-bottom: none; }
.payer-option.selected { background: #EEF2FF; margin: 0 -16rpx; padding: 20rpx 16rpx; border-radius: 12rpx; }
.payer-option-avatar { font-size: 36rpx; margin-right: 16rpx; }
.payer-option-name { font-size: 30rpx; color: #1F2937; flex: 1; }
.payer-option-check { font-size: 28rpx; color: #4F46E5; font-weight: 700; }
.payer-option.add { color: #9CA3AF; }
.payer-option.add .payer-option-avatar { font-size: 28rpx; border: 2rpx dashed #D1D5DB; border-radius: 50%; width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }

/* 添加人员弹窗 */
.modal-content { width: 80%; background: #FFF; border-radius: 28rpx; overflow: hidden; }
.modal-header { text-align: center; font-size: 32rpx; font-weight: 700; color: #1F2937; padding: 36rpx 28rpx 12rpx; }
.modal-body { padding: 16rpx 36rpx 28rpx; }
.form-input { border: 2rpx solid #E5E7EB; border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; background: #F9FAFB; }
.modal-footer { display: flex; border-top: 1rpx solid #F3F4F6; }
.modal-footer view { flex: 1; text-align: center; padding: 28rpx; font-size: 30rpx; }
.btn-cancel { color: #6B7280; }
.btn-primary { color: #4F46E5; font-weight: 700; }
