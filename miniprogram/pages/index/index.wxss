/* pages/index/index.wxss — 首页样式 */

/* 骨架屏 */
.skeleton { padding: 24rpx 28rpx; }
.sk-overview {
  height: 240rpx; background: linear-gradient(90deg, #F0F2F5 25%, #E8EAF0 50%, #F0F2F5 75%);
  background-size: 200% 100%; border-radius: 24rpx; margin-bottom: 24rpx;
  animation: shimmer 1.5s ease-in-out infinite;
}
.sk-row { height: 80rpx; background: #FFFFFF; border-radius: 16rpx; margin-bottom: 12rpx; }
.sk-line {
  height: 100%; background: linear-gradient(90deg, #F0F2F5 25%, #E8EAF0 50%, #F0F2F5 75%);
  background-size: 200% 100%; animation: shimmer 1.5s ease-in-out infinite; border-radius: 16rpx;
}

.content-fade { animation: fadeIn 0.3s ease-out; }
@keyframes fadeIn { from{opacity:0;transform:translateY(16rpx)} to{opacity:1;transform:translateY(0)} }

/* 概览卡片 */
.overview-card {
  background: linear-gradient(135deg, #1A73E8, #4285F4);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(26, 115, 232, 0.3);
}
.overview-month { font-size: 26rpx; opacity: 0.85; margin-bottom: 8rpx; }
.overview-balance {
  font-size: 56rpx; font-weight: 700; margin-bottom: 28rpx;
  font-variant-numeric: tabular-nums;
}
.overview-balance.negative { color: #FFCDD2; }
.overview-row { display: flex; align-items: center; }
.overview-item { flex: 1; display: flex; flex-direction: column; }
.overview-label { font-size: 24rpx; opacity: 0.75; margin-bottom: 6rpx; }
.overview-amount { font-size: 32rpx; font-weight: 700; color: #FFFFFF !important; }
.overview-change { font-size: 22rpx; margin-top: 4rpx; }
.overview-change.text-income { color: #A5D6A7 !important; }
.overview-change.text-expense { color: #FFCDD2 !important; }
.overview-divider { width: 1rpx; height: 60rpx; background: rgba(255,255,255,0.2); margin: 0 32rpx; }

/* 预算 */
.budget-card { padding: 24rpx 28rpx; }
.budget-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.budget-title { font-size: 28rpx; font-weight: 600; color: #2D3436; }
.budget-amount { font-size: 28rpx; font-weight: 600; color: #1A73E8; }
.budget-bar {
  height: 12rpx; background: #F0F2F5; border-radius: 6rpx; overflow: hidden; margin-bottom: 12rpx;
}
.budget-fill {
  height: 100%; background: linear-gradient(90deg, #4CAF50, #66BB6A);
  border-radius: 6rpx; transition: width 0.3s ease;
}
.budget-fill.warning { background: linear-gradient(90deg, #FF9800, #FF5722); }
.budget-info { display: flex; justify-content: space-between; font-size: 22rpx; color: #90A4AE; }

/* 区块 */
.section { margin-bottom: 24rpx; }
.section-title {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 8rpx; font-size: 30rpx; font-weight: 600; color: #2D3436;
}
.section-more { font-size: 24rpx; color: #1A73E8; font-weight: 400; }

/* 账单条目 */
.bill-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid #F0F2F5;
}
.bill-item:last-child { border-bottom: none; }
.bill-left { display: flex; align-items: center; flex: 1; }
.bill-icon { font-size: 40rpx; margin-right: 16rpx; }
.bill-info { display: flex; flex-direction: column; }
.bill-category { font-size: 28rpx; font-weight: 500; color: #2D3436; }
.bill-note { font-size: 22rpx; color: #90A4AE; margin-top: 4rpx; max-width: 300rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bill-right { display: flex; flex-direction: column; align-items: flex-end; }
.bill-amount { font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.bill-date { font-size: 22rpx; color: #90A4AE; margin-top: 4rpx; }

/* 浮动按钮 */
.fab {
  position: fixed; right: 40rpx; bottom: calc(env(safe-area-inset-bottom) + 180rpx);
  width: 108rpx; height: 108rpx; border-radius: 54rpx;
  background: linear-gradient(135deg, #1A73E8, #4285F4);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(26, 115, 232, 0.4);
  z-index: 100;
}
.fab:active { transform: scale(0.92); }
.fab-icon { font-size: 48rpx; color: #FFFFFF; font-weight: 300; }
